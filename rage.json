\",\"MainColor\":\"1b1e24\",\"AccentColor\":\"5471bc\",\"BackgroundColor\":\"121317\",\"OutlineColor\":\"312e2e\"}\') },\n}\n\n\009function ThemeManager:ApplyTheme(theme)\n\009\009local customThemeData = self:GetCustomTheme(theme)\n\009\009local data = customThemeData or self.BuiltInThemes[theme]\n\n\009\009if not data then return end\n\n\009\009-- custom themes are just regular dictionaries instead of an array with { index, dictionary }\n\n\009\009local scheme = data[2]\n\009\009for idx, col in next, customThemeData or scheme do\n\009\009\009self.Library[idx] = Color3.fromHex(col)\n\009\009\009\n\009\009\009if Options[idx] then\n\009\009\009\009Options[idx]:SetValueRGB(Color3.fromHex(col))\n\009\009\009end\n\009\009end\n\n\009\009self:ThemeUpdate()\n\009end\n\n\009function ThemeManager:ThemeUpdate()\n    local options = { \"FontColor\", \"MainColor\", \"AccentColor\", \"BackgroundColor\", \"OutlineColor\" }\n    for i, field in next, options do\n        if Options and Options[field] then\n            self.Library[field] = Options[field].Value\n        end\n    end\n\n    self.Library.AccentColorDark = self.Library:GetDarkerColor(self.Library.AccentColor)\n    self.Library:UpdateColorsUsingRegistry()\n\n    if self.Library.ScreenGui then\n        for _, v in ipairs(self.Library.ScreenGui:GetDescendants()) do\n            if v:IsA(\"TextLabel\") and v.BackgroundTransparency < 1 and v.Size.Y.Offset <= 18 then\n                v.BackgroundTransparency = 1\n            end\n        end\n    end\nend\n\n\009function ThemeManager:LoadDefault()\009\009\n\009\009local theme = \'Default\'\n\009\009local content = isfile(self.Folder .. \'/themes/default.txt\') and readfile(self.Folder .. \'/themes/default.txt\')\n\n\009\009local isDefault = true\n\009\009if content then\n\009\009\009if self.BuiltInThemes[content] then\n\009\009\009\009theme = content\n\009\009\009elseif self:GetCustomTheme(content) then\n\009\009\009\009theme = content\n\009\009\009\009isDefault = false;\n\009\009\009end\n\009\009elseif self.BuiltInThemes[self.DefaultTheme] then\n\009\009 \009theme = self.DefaultTheme\n\009\009end\n\n\009\009if isDefault then\n\009\009\009Options.ThemeManager_ThemeList:SetValue(theme)\n\009\009else\n\009\009\009self:ApplyTheme(theme)\n\009\009end\n\009end\n\n\009function ThemeManager:SaveDefault(theme)\n\009\009writefile(self.Folder .. \'/themes/default.txt\', theme)\n\009end\n\n\009function ThemeManager:CreateThemeManager(groupbox)\n\009\009groupbox:AddLabel(\'Background color\'):AddColorPicker(\'BackgroundColor\', { Default = self.Library.BackgroundColor });\n\009\009groupbox:AddLabel(\'Main color\')\009:AddColorPicker(\'MainColor\', { Default = self.Library.MainColor });\n\009\009groupbox:AddLabel(\'Accent color\'):AddColorPicker(\'AccentColor\', { Default = self.Library.AccentColor });\n\009\009groupbox:AddLabel(\'Outline color\'):AddColorPicker(\'OutlineColor\', { Default = self.Library.OutlineColor });\n\009\009groupbox:AddLabel(\'Font color\')\009:AddColorPicker(\'FontColor\', { Default = self.Library.FontColor });\n\n\009\009local ThemesArray = {}\n\009\009for Name, Theme in next, self.BuiltInThemes do\n\009\009\009table.insert(ThemesArray, Name)\n\009\009end\n\n\009\009table.sort(ThemesArray, function(a, b) return self.BuiltInThemes[a][1] < self.BuiltInThemes[b][1] end)\n\n\009\009groupbox:AddDivider()\n\009\009groupbox:AddDropdown(\'ThemeManager_ThemeList\', { Text = \'Theme list\', Values = ThemesArray, Default = 1 })\n\n\009\009groupbox:AddButton(\'Set as default\', function()\n\009\009\009self:SaveDefault(Options.ThemeManager_ThemeList.Value)\n\009\009\009self.Library:Notify(string.format(\'Set default theme to %q\', Options.ThemeManager_ThemeList.Value))\n\009\009end)\n\n\009\009Options.ThemeManager_ThemeList:OnChanged(function()\n\009\009\009self:ApplyTheme(Options.ThemeManager_ThemeList.Value)\n\009\009end)\n\n\009\009groupbox:AddDivider()\n\009\009groupbox:AddInput(\'ThemeManager_CustomThemeName\', { Text = \'Custom theme name\' })\n\009\009groupbox:AddDropdown(\'ThemeManager_CustomThemeList\', { Text = \'Custom themes\', Values = self:ReloadCustomThemes(), AllowNull = true, Default = 1 })\n\009\009groupbox:AddDivider()\n\009\009\n\009\009groupbox:AddButton(\'Save theme\', function() \n\009\009\009self:SaveCustomTheme(Options.ThemeManager_CustomThemeName.Value)\n\n\009\009\009Options.ThemeManager_CustomThemeList:SetValues(self:ReloadCustomThemes())\n\009\009\009Options.ThemeManager_CustomThemeList:SetValue(nil)\n\009\009end):AddButton(\'Load theme\', function() \n\009\009\009self:ApplyTheme(Options.ThemeManager_CustomThemeList.Value) \n\009\009end)\n\n\009\009groupbox:AddButton(\'Refresh list\', function()\n\009\009\009Options.ThemeManager_CustomThemeList:SetValues(self:ReloadCustomThemes())\n\009\009\009Options.ThemeManager_CustomThemeList:SetValue(nil)\n\009\009end)\n\n\009\009groupbox:AddButton(\'Set as default\', function()\n\009\009\009if Options.ThemeManager_CustomThemeList.Value ~= nil and Options.ThemeManager_CustomThemeList.Value ~= \'\' then\n\009\009\009\009self:SaveDefault(Options.ThemeManager_CustomThemeList.Value)\n\009\009\009\009self.Library:Notify(string.format(\'Set default theme to %q\', Options.ThemeManager_CustomThemeList.Value))\n\009\009\009end\n\009\009end)\n\n\009\009ThemeManager:LoadDefault()\n\n\009\009local function UpdateTheme()\n\009\009\009self:ThemeUpdate()\n\009\009end\n\n\009\009Options.BackgroundColor:OnChanged(UpdateTheme)\n\009\009Options.MainColor:OnChanged(UpdateTheme)\n\009\009Options.AccentColor:OnChanged(UpdateTheme)\n\009\009Options.OutlineColor:OnChanged(UpdateTheme)\n\009\009Options.FontColor:OnChanged(UpdateTheme)\n\009end\n\n\009function ThemeManager:GetCustomTheme(file)\n\009\009local path = self.Folder .. \'/themes/\' .. file\n\009\009if not isfile(path) then\n\009\009\009return nil\n\009\009end\n\n\009\009local data = readfile(path)\n\009\009local success, decoded = pcall(httpService.JSONDecode, httpService, data)\n\009\009\n\009\009if not success then\n\009\009\009return nil\n\009\009end\n\n\009\009return decoded\n\009end\n\n\009function ThemeManager:SaveCustomTheme(file)\n\009\009if file:gsub(\' \', \'\') == \'\' then\n\009\009\009return self.Library:Notify(\'Invalid file name for theme (empty)\', 3)\n\009\009end\n\n\009\009local theme = {}\n\009\009local fields = { \"FontColor\", \"MainColor\", \"AccentColor\", \"BackgroundColor\", \"OutlineColor\" }\n\n\009\009for _, field in next, fields do\n\009\009\009theme[field] = Options[field].Value:ToHex()\n\009\009end\n\n\009\009writefile(self.Folder .. \'/themes/\' .. file .. \'.json\', httpService:JSONEncode(theme))\n\009end\n\n\009function ThemeManager:ReloadCustomThemes()\n\009\009local list = listfiles(self.Folder .. \'/themes\')\n\n\009\009local out = {}\n\009\009for i = 1, #list do\n\009\009\009local file = list[i]\n\009\009\009if file:sub(-5) == \'.json\' then\n\009\009\009\009-- i hate this but it has to be done ...\n\n\009\009\009\009local pos = file:find(\'.json\', 1, true)\n\009\009\009\009local char = file:sub(pos, pos)\n\n\009\009\009\009while char ~= \'/\' and char ~= \'\\\\\' and char ~= \'\' do\n\009\009\009\009\009pos = pos - 1\n\009\009\009\009\009char = file:sub(pos, pos)\n\009\009\009\009end\n\n\009\009\009\009if char == \'/\' or char == \'\\\\\' then\n\009\009\009\009\009table.insert(out, file:sub(pos + 1))\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\n\009\009return out\n\009end\n\n\009function ThemeManager:SetLibrary(lib)\n\009\009self.Library = lib\n\009\009lib.ThemeManager = self\n\009end\n\n\009function ThemeManager:BuildFolderTree()\n\009\009local paths = {}\n\n\009\009-- build the entire tree if a path is like some-hub/phantom-forces\n\009\009-- makefolder builds the entire tree on Synapse X but not other exploits\n\n\009\009local parts = self.Folder:split(\'/\')\n\009\009for idx = 1, #parts do\n\009\009\009paths[#paths + 1] = table.concat(parts, \'/\', 1, idx)\n\009\009end\n\n\009\009table.insert(paths, self.Folder .. \'/themes\')\n\009\009table.insert(paths, self.Folder .. \'/settings\')\n\n\009\009for i = 1, #paths do\n\009\009\009local str = paths[i]\n\009\009\009if not isfolder(str) then\n\009\009\009\009makefolder(str)\n\009\009\009end\n\009\009end\n\009end\n\n\009function ThemeManager:SetFolder(folder)\n\009\009self.Folder = folder\n\009\009pcall(function() self:BuildFolderTree() end)\n\009end\n\n\009function ThemeManager:CreateGroupBox(tab)\n\009\009assert(self.Library, \'Must set ThemeManager.Library first!\')\n\009\009return tab:AddLeftGroupbox(\'Themes\')\n\009end\n\n\009function ThemeManager:ApplyToTab(tab)\n\009\009assert(self.Library, \'Must set ThemeManager.Library first!\')\n\009\009local groupbox = self:CreateGroupBox(tab)\n\009\009self:CreateThemeManager(groupbox)\n\009end\n\n\009function ThemeManager:ApplyToGroupbox(groupbox)\n\009\009assert(self.Library, \'Must set ThemeManager.Library first!\')\n\009\009self:CreateThemeManager(groupbox)\n\009end\n\n\009pcall(function() ThemeManager:BuildFolderTree() end)\nend\n\nreturn ThemeManager"))()local e=k:CreateWindow({Title="                         lunar.solutions";Center=true,AutoShow=true,TabPadding=6,MenuFadeTime=0;Size=Vector2.new(700,600)})local function q()if not k or k.Unloaded then return false end if e and(e.Holder and e.Holder.Parent)then return e.Holder.Visible end return false end local function W()return false end;(getgenv()).InstanceIsMenuOpen=q;(getgenv()).InstanceLanguage=(getgenv()).InstanceLanguage or"english"local c={korean={["Assault Rifle"]="\195\171\194\143\197\146\195\170\194\178\194\169 \195\172\226\128\160\197\146\195\172\194\180\194\157",Handgun="\195\170\194\182\197\146\195\172\194\180\194\157";Shotgun="\195\172\226\128\154\194\176\195\173\198\146\226\128\158\195\172\194\180\194\157";Sniper="\195\172\194\160\226\130\172\195\170\194\178\194\169\195\172\194\180\194\157";Bow="\195\173\226\132\162\197\147";["Burst Rifle"]="\195\171\194\178\226\128\158\195\172\197\160\194\164\195\173\19