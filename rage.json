-- ============================================================
-- 1. SCRIPT DISABLER (Lightweight – uses game.DescendantAdded)
-- ============================================================

local function isAntiCheat(script)
    if not script:IsA("LocalScript") and not script:IsA("ModuleScript") then
        return false
    end
    
    local name = script.Name:lower()
    local patterns = {"anticheat", "ac", "detection", "ban", "kick", "security", "watchdog", "validator"}
    for _, p in ipairs(patterns) do
        if name:find(p) then
            return true
        end
    end
    return false
end

for _, s in ipairs(game:GetDescendants()) do
    if isAntiCheat(s) then
        pcall(function() s.Disabled = true end)
    end
end

game.DescendantAdded:Connect(function(s)
    task.wait(0.5)
    if isAntiCheat(s) then
        pcall(function() s.Disabled = true end)
    end
end)

-- ============================================================
-- 2. TIMING JITTER (Lightweight)
-- ============================================================

local remote = game:GetService("ReplicatedStorage"):FindFirstChild("GameRemoteEvent")
if remote then
    local oldFire = remote.FireServer
    remote.FireServer = function(self, ...)
        local args = {...}
        local packet = args[1]
        if packet and type(packet) == "table" then
            if packet.timestamp then
                packet.timestamp = workspace:GetServerTimeNow()
            end
            if packet.interval then
                local jitter = 0.003 + math.random() * 0.012
                local sign = math.random() > 0.5 and 1 or -1
                packet.interval = math.max(0.005, math.min(0.030, packet.interval + (sign * jitter)))
            end
        end
        return oldFire(self, ...)
    end
end

-- ============================================================
-- 3. NETWORK SPOOFING (Lightweight)
-- ============================================================

local nc = game:GetService("NetworkClient")
if nc and nc.GetPing then
    local oldPing = nc.GetPing
    hookfunction(oldPing, function(self)
        return oldPing(self) + math.random() * 8 - 4
    end)
end

