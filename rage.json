local UserInputService = game:GetService("UserInputService")

UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.F8 then
        -- Force FFA mode
        if not isFFAMode then
            print("[FFA Detector] 🔧 Manually forcing FFA mode (F8)")
            enableFFAMode()
        else
            print("[FFA Detector] 🔧 Already in FFA mode")
        end
    end
    
    if input.KeyCode == Enum.KeyCode.F9 then
        -- Force normal mode
        if isFFAMode then
            print("[FFA Detector] 🔧 Manually forcing Normal mode (F9)")
            disableFFAMode()
        else
            print("[FFA Detector] 🔧 Already in Normal mode")
        end
    end
end)

