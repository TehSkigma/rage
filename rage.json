 function(idx, object)\n\009\009\009\009return { type = \'Input\', idx = idx, text = object.Value }\n\009\009\009end,\n\009\009\009Load = function(idx, data)\n\009\009\009\009if Options[idx] and type(data.text) == \'string\' then\n\009\009\009\009\009Options[idx]:SetValue(data.text)\n\009\009\009\009end\n\009\009\009end,\n\009\009},\n\n\009\009Theme = {\n\009\009\009Save = function()\n\009\009\009\009local colors = {}\n\009\009\009\009for _, name in ipairs({\"FontColor\", \"MainColor\", \"BackgroundColor\", \"AccentColor\", \"OutlineColor\", \"RiskColor\"}) do\n\009\009\009\009\009if Library[name] then\n\009\009\009\009\009\009colors[name] = Library[name]:ToHex()\n\009\009\009\009\009end\n\009\009\009\009end\n\009\009\009\009return { type = \'Theme\', colors = colors }\n\009\009\009end,\n\009\009\009Load = function(data)\n\009\009\009\009if not data.colors then return end\n\009\009\009\009for name, hex in pairs(data.colors) do\n\009\009\009\009\009if Library[name] then\n\009\009\009\009\009\009Library[name] = Color3.fromHex(hex)\n\009\009\009\009\009end\n\009\009\009\009end\n\009\009\009\009Library:UpdateColorsUsingRegistry()\n\009\009\009end,\n\009\009}\n\009}\n\n\009function SaveManager:SetIgnoreIndexes(list)\n\009\009for _, key in next, list do\n\009\009\009self.Ignore[key] = true\n\009\009end\n\009end\n\n\009function SaveManager:SetFolder(folder)\n\009\009self.Folder = folder\n\009\009pcall(function() self:BuildFolderTree() end)\n\009end\n\n\009function SaveManager:Save(name)\n\009\009if not name or name:gsub(\"%s+\", \"\") == \"\" then\n\009\009\009return false, \"no config name\"\n\009\009end\n\n\009\009local fullPath = self.Folder .. \'/settings/\' .. name .. \'.json\'\n\n\009\009local data = { objects = {}, theme = nil }\n\n\009\009for idx, toggle in next, Toggles do\n\009\009\009if self.Ignore[idx] then continue end\n\009\009\009table.insert(data.objects, self.Parser.Toggle.Save(idx, toggle))\n\009\009end\n\n\009\009for idx, option in next, Options do\n\009\009\009if self.Ignore[idx] then continue end\n\009\009\009\n\009\009\009local parser = nil\n\009\009\009\n\009\009\009if option.Type == \'KeyPicker\' then\n\009\009\009\009parser = self.Parser.KeyPicker\n\009\009\009elseif option.Type == \'Keybind\' then\n\009\009\009\009parser = self.Parser.Keybind\n\009\009\009else\n\009\009\009\009parser = self.Parser[option.Type]\n\009\009\009end\n\009\009\009\n\009\009\009if parser and parser.Save then\n\009\009\009\009table.insert(data.objects, parser.Save(idx, option))\n\009\009\009end\n\009\009end\n\n\009\009data.theme = self.Parser.Theme.Save()\n\n\009\009local success, encoded = pcall(httpService.JSONEncode, httpService, data)\n\009\009if not success then return false, \'encode failed\' end\n\n\009\009writefile(fullPath, encoded)\n\009\009return true\n\009end\n\n\009function SaveManager:Load(name)\n\009\009if not name then return false, \'no config selected\' end\n\n\009\009local file = self.Folder .. \'/settings/\' .. name .. \'.json\'\n\009\009if not isfile(file) then return false, \'file not found\' end\n\n\009\009local success, decoded = pcall(httpService.JSONDecode, httpService, readfile(file))\n\009\009if not success then return false, \'decode failed\' end\n\n\009\009for _, obj in next, decoded.objects or {} do\n\009\009\009local parser = nil\n\009\009\009\n\009\009\009if obj.type == \'KeyPicker\' then\n\009\009\009\009parser = self.Parser.KeyPicker\n\009\009\009elseif obj.type == \'Keybind\' then\n\009\009\009\009parser = self.Parser.Keybind\n\009\009\009else\n\009\009\009\009parser = self.Parser[obj.type]\n\009\009\009end\n\009\009\009\n\009\009\009if parser and parser.Load then\n\009\009\009\009task.spawn(parser.Load, obj.idx, obj)\n\009\009\009end\n\009\009end\n\n\009\009if decoded.theme then\n\009\009\009self.Parser.Theme.Load(decoded.theme)\n\009\009end\n\n\009\009return true\n\009end\n\n\009function SaveManager:IgnoreThemeSettings()\n\009\009self:SetIgnoreIndexes({ \n\009\009\009\"BackgroundColor\", \"MainColor\", \"AccentColor\", \"OutlineColor\", \"FontColor\", \"RiskColor\",\n\009\009\009\"ThemeManager_ThemeList\", \"ThemeManager_CustomThemeList\", \"ThemeManager_CustomThemeName\"\n\009\009})\n\009end\n\n\009function SaveManager:BuildFolderTree()\n\009\009local paths = { self.Folder, self.Folder .. \'/themes\', self.Folder .. \'/settings\' }\n\009\009for _, path in ipairs(paths) do\n\009\009\009if not isfolder(path) then makefolder(path) end\n\009\009end\n\009end\n\n\009function SaveManager:RefreshConfigList()\n\009\009local list = listfiles(self.Folder .. \'/settings\')\n\009\009local out = {}\n\009\009for _, file in ipairs(list) do\n\009\009\009if file:sub(-5) == \'.json\' then\n\009\009\009\009local name = file:match(\"([^/\\\\]+)%.json$\")\n\009\009\009\009if name then table.insert(out, name) end\n\009\009\009end\n\009\009end\n\009\009return out\n\009end\n\n\009function SaveManager:SetLibrary(library)\n\009\009self.Library = library\n\009\009library.SaveManager = self\n\009end\n\n\009function SaveManager:LoadAutoloadConfig()\n\009\009local path = self.Folder .. \'/settings/autoload.txt\'\n\009\009if isfile(path) then\n\009\009\009local name = readfile(path):gsub(\"%s+\", \"\")\n\009\009\009if name ~= \"\" then\n\009\009\009\009local success, err = self:Load(name)\n\009\009\009\009if success then\n\009\009\009\009\009self.Library:Notify(\'Auto-loaded config: \' .. name, 4)\n\009\009\009\009else\n\009\009\009\009\009self.Library:Notify(\'Failed to auto-load: \' .. err, 4)\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\009end\n\n\009function SaveManager:BuildConfigSection(tab)\n\009\009assert(self.Library, \'Library not set\')\n\n\009\009local section = tab:AddRightGroupbox(\'Configs\')\n\n\009\009section:AddInput(\'SaveManager_ConfigName\', { Text = \'Config Name\' })\n\009\009section:AddDropdown(\'SaveManager_ConfigList\', { \n\009\009\009Text = \'Config List\', \n\009\009\009Values = self:RefreshConfigList(), \n\009\009\009AllowNull = true \n\009\009})\n\n\009\009section:AddDivider()\n\n\009\009section:AddButton(\'Create Config\', function()\n\009\009\009local name = Options.SaveManager_ConfigName.Value\n\009\009\009if name:gsub(\"%s+\", \"\") == \"\" then\n\009\009\009\009return self.Library:Notify(\'Config name cannot be empty\', 2)\n\009\009\009end\n\n\009\009\009local success, err = self:Save(name)\n\009\009\009if success then\n\009\009\009\009self.Library:Notify(\'Created config: \' .. name, 3)\n\009\009\009\009Options.SaveManager_ConfigList:SetValues(self:RefreshConfigList())\n\009\009\009else\n\009\009\009\009self.Library:Notify(\'Failed to save: \' .. err, 3)\n\009\009\009end\n\009\009end):AddButton(\'Load Config\', function()\n\009\009\009local name = Options.SaveManager_ConfigList.Value\n\009\009\009if not name then return end\n\n\009\009\009local success, err = self:Load(name)\n\009\009\009if success then\n\009\009\009\009self.Library:Notify(\'Loaded: \' .. name, 3)\n\009\009\009else\n\009\009\009\009self.Library:Notify(\'Load failed: \' .. err, 3)\n\009\009\009end\n\009\009end)\n\n\009\009section:AddButton(\'Overwrite Config\', function()\n\009\009\009local name = Options.SaveManager_ConfigList.Value\n\009\009\009if not name then return end\n\009\009\009local success, err = self:Save(name)\n\009\009\009if success then\n\009\009\009\009self.Library:Notify(\'Overwrote: \' .. name, 3)\n\009\009\009else\n\009\009\009\009self.Library:Notify(\'Overwrite failed: \' .. err, 3)\n\009\009\009end\n\009\009end)\n\n\009\009section:AddButton(\'Refresh List\', function()\n\009\009\009Options.SaveManager_ConfigList:SetValues(self:RefreshConfigList())\n\009\009end)\n\n\009\009section:AddButton(\'Set as Autoload\', function()\n\009\009\009local name = Options.SaveManager_ConfigList.Value\n\009\009\009if not name then return end\n\009\009\009writefile(self.Folder .. \'/settings/autoload.txt\', name)\n\009\009\009self.Library:Notify(\'Set \' .. name .. \' as autoload\', 3)\n\009\009end)\n\n\009\009SaveManager.AutoloadLabel = section:AddLabel(\'Autoload: none\', true)\n\n\009\009if isfile(self.Folder .. \'/settings/autoload.txt\') then\n\009\009\009local name = readfile(self.Folder .. \'/settings/autoload.txt\')\n\009\009\009SaveManager.AutoloadLabel:SetText(\'Autoload: \' .. name)\n\009\009end\n\n\009\009SaveManager:SetIgnoreIndexes({ \'SaveManager_ConfigList\', \'SaveManager_ConfigName\' })\n\009end\n\n\009pcall(function() SaveManager:BuildFolderTree() end)\nend\n\nreturn SaveManager"))()local C=(loadstring("local httpService = game:GetService(\'HttpService\')\nlocal ThemeManager = {} do\n\009ThemeManager.Folder = \'LinoriaLibSettings\'\n\009-- if not isfolder(ThemeManager.Folder) then makefolder(ThemeManager.Folder) end\n\n\009ThemeManager.Library = nil\n\009ThemeManager.BuiltInThemes = {\n    [\'Default\'] = { 1, httpService:JSONDecode(\'{\"FontColor\":\"ffffff\",\"MainColor\":\"1c1c1c\",\"AccentColor\":\"c8956c\",\"BackgroundColor\":\"141414\",\"OutlineColor\":\"323232\"}\') },\n    [\'Purple\'] = { 2, httpService:JSONDecode(\'{\"FontColor\":\"ffffff\",\"MainColor\":\"1c1c1c\",\"AccentColor\":\"4400ff\",\"BackgroundColor\":\"141414\",\"OutlineColor\":\"323232\"}\') },\n    [\'Fatality\'] = { 3, httpService:JSONDecode(\'{\"FontColor\":\"ffffff\",\"MainColor\":\"1e1842\",\"AccentColor\":\"c50754\",\"BackgroundColor\":\"191335\",\"OutlineColor\":\"3c355d\"}\') },\n    [\'Mint\'] = { 4, httpService:JSONDecode(\'{\"FontColor\":\"ffffff\",\"MainColor\":\"242424\",\"AccentColor\":\"3db488\",\"BackgroundColor\":\"1c1c1c\",\"OutlineColor\":\"373737\"}\') },\n    [\'Tokyo Night\'] = { 5, httpService:JSONDecode(\'{\"FontColor\":\"ffffff\",\"MainColor\":\"191925\",\"AccentColor\":\"6759b3\",\"BackgroundColor\":\"16161f\",\"OutlineColor\":\"323232\"}\') },\n    [\'Quartz\'] = { 6, httpService:JSONDecode(\'{\"FontColor\":\"ffffff\",\"MainColor\":\"232330\",\"AccentColor\":\"426e87\",\"BackgroundColor\":\"1d1b26\",\"OutlineColor\":\"27232f\"}\') },\n    [\'Silver Lake\'] = { 7, httpService:JSONDecode(\'{\"FontColor\":\"c7c7c8\",\"MainColor\":\"1b1e24\",\"AccentColor\":\"5471bc\",\"BackgroundColor\":\"121317\",\"OutlineColor\":\"312e2e\"}\') },\n}\n\n\009function ThemeManager:ApplyTheme(theme)\n\009\009local customThemeData = self:GetCustomTheme(theme)\n\009\009local data = customThemeData or self.BuiltInThemes[theme]\n\n\009\009if not data then return end\n\n\009\009-- custom themes are just regular dictionaries instead of an array with { index, dictionary }\n\n\009\009local scheme = data[2]\n\009\009for idx, col in next, customThemeData or scheme do\n\009\009\009self.Library[idx] = Color3.fromHex(col)\n\009\009\009\n\009\009\009if Options[idx] then\n\009\009\009\009Options[idx]:SetValueRGB(Color3.fromHex(col))\n\009\009\009end\n\009\009end\n\n\009\009self:ThemeUpdate()\n\009end\n\n\009function ThemeManager:ThemeUpdate()\n    local options = { \"FontColor\", \"MainColor\", \"AccentColor\", \"BackgroundColor\", \"OutlineColor\" }\n    for i, field in next, options do\n        if Options and Options[field] then\n            self.Library[field] = Options[field].Value\n        end\n    end\n\n    self.Library.AccentColorDark = self.Library:GetDarkerColor(self.Library.AccentColor)\n    self.Library:UpdateColorsUsingRegistry()\n\n    if self.Library.ScreenGui then\n        for _, v in ipairs(self.Library.ScreenGui:GetDescendants()) do\n            if v:IsA(\"TextLabel\") and v.BackgroundTransparency < 1 and v.Size.Y.Offset <= 18 then\n                v.BackgroundTransparency = 1\n            end\n        end\n    end\nend\n\n\009function ThemeManager:LoadDefault()\009\009\n\009\009local theme = \'Default\'\n\009\009local content = isfile(self.Folder .. \'/themes/default.txt\') and readfile(self.Folder .. \'/themes/default.txt\')\n\n\009\009local isDefault = true\n\009\009if content then\n\009\009\009if self.BuiltInThemes[content] then\n\009\009\009\009theme = content\n\009\009\009elseif self:GetCustomTheme(content) then\n\009\009\009\009theme = content\n\009\009\009\009isDefault = false;\n\009\009\009end\n\009\009elseif self.BuiltInThemes[self.DefaultTheme] then\n\009\009 \009theme = self.DefaultTheme\n\009\009end\n\n\009\009if isDefault then\n\009\009\009Options.ThemeManager_ThemeList:SetValue(theme)\n\009\009else\n\009\009\009self:ApplyTheme(theme)\n\009\009end\n\009end\n\n\009function ThemeManager:SaveDefault(theme)\n\009\009writefile(self.Folder .. \'/themes/default.txt\', theme)\n\009end\n\n\009function ThemeManager:CreateThemeManager(groupbox)\n\009\009groupbox:AddLabel(\'Background color\'):AddColorPicker(\'BackgroundColor\', { Default = self.Library.BackgroundColor });\n\009\009groupbox:AddLabel(\'Main color\')\009:AddColorPicker(\'MainColor\', { Default = self.Library.MainColor });\n\009\009groupbox:AddLabel(\'Accent color\'):AddColorPicker(\'AccentColor\', { Default = self.Library.AccentColor });\n\009\009groupbox:AddLabel(\'Outline color\'):AddColorPicker(\'OutlineColor\', { Default = self.Library.OutlineColor });\n\009\009groupbox:AddLabel(\'Font color\')\009:AddColorPicker(\'FontColor\', { Default = self.Library.FontColor });\n\n\009\009local ThemesArray = {}\n\009\009for Name, Theme in next, self.BuiltInThemes do\n\009\009\009table.insert(ThemesArray, Name)\n\009\009end\n\n\009\009table.sort(ThemesArray, function(a, b) return self.BuiltInThemes[a][1] < self.BuiltInThemes[b][1] end)\n\n\009\009groupbox:AddDivider()\n\009\009groupbox:AddDropdown(\'ThemeManager_ThemeList\', { Text = \'Theme list\', Values = ThemesArray, Default = 1 })\n\n\009\009groupbox:AddButton(\'Set as default\', function()\n\009\009\009self:SaveDefault(Options.ThemeManager_ThemeList.Value)\n\009\009\009self.Library:Notify(string.format(\'Set default theme to %q\', Options.ThemeManager_ThemeList.Value))\n\009\009end)\n\n\009\009Options.ThemeManager_ThemeList:OnChanged(function()\n\009\009\009self:ApplyTheme(Options.ThemeManager_ThemeList.Value)\n\009\009end)\n\n\009\009groupbox:AddDivider()\n\009\009groupbox:AddInput(\'ThemeManager_CustomThemeName\', { Text = \'Custom theme name\' })\n\009\009groupbox:AddDropdown(\'ThemeManager_CustomThemeList\', { Text = \'Custom themes\', Values = self:ReloadCustomThemes(), AllowNull = true, Default = 1 })\n\009\009groupbox:AddDivider()\n\009\009\n\009\009groupbox:AddButton(\'Save theme\', function() \n\009\009\009self:SaveCustomTheme(Options.ThemeManager_CustomThemeName.Value)\n\n\009\009\009Options.ThemeManager_CustomThemeList:SetValues(self:ReloadCustomThemes())\n\009\009\009Options.ThemeManager_CustomThemeList:SetValue(nil)\n\009\009end):AddButton(\'Load theme\', function() \n\009\009\009self:ApplyTheme(Options.ThemeManager_CustomThemeList.Value) \n\009\009end)\n\n\009\009groupbox:AddButton(\'Refresh list\', function()\n\009\009\009Options.ThemeManager_CustomThemeList:SetValues(self:ReloadCustomThemes())\n\009\009\009Options.ThemeManager_CustomThemeList:SetValue(nil)\n\009\009end)\n\n\009\009groupbox:AddButton(\'Set as default\', function()\n\009\009\009if Options.ThemeManager_CustomThemeList.Value ~= nil and Options.ThemeManager_CustomThemeList.Value ~= \'\' then\n\009\009\009\009self:SaveDefault(Options.ThemeManager_CustomThemeList.Value)\n\009\009\009\009self.Library:Notify(string.format(\'Set default theme to %q\', Options.ThemeManager_CustomThemeList.Value))\n\009\009\009end\n\009\009end)\n\n\009\009ThemeManager:LoadDefault()\n\n\009\009local function UpdateTheme()\n\009\009\009self:ThemeUpdate()\n\009\009end\n\n\009\009Options.BackgroundColor:OnChanged(UpdateTheme)\n\009\009Options.MainColor:OnChanged(UpdateTheme)\n\009\009Options.AccentColor:OnChanged(UpdateTheme)\n\009\009Options.OutlineColor:OnChanged(UpdateTheme)\n\009\009Options.FontColor:OnChanged(UpdateTheme)\n\009end\n\n\009function ThemeManager:GetCustomTheme(file)\n\009\009local path = self.Folder .. \'/themes/\' .. file\n\009\009if not isfile(path) then\n\009\009\009return nil\n\009\009end\n\n\009\009local data = readfile(path)\n\009\009local success, decoded = pcall(httpService.JSONDecode, httpService, data)\n\009\009\n\009\009if not success then\n\009\009\009return nil\n\009\009end\n\n\009\009return decoded\n\009end\n\n\009function ThemeManager:SaveCustomTheme(file)\n\009\009if file:gsub(\' \', \'\') == \'\' then\n\009\009\009return self.Library:Notify(\'Invalid file name for theme (empty)\', 3)\n\009\009end\n\n\009\009local theme = {}\n\009\009local fields = { \"FontColor\", \"MainColor\", \"AccentColor\", \"BackgroundColor\", \"OutlineColor\" }\n\n\009\009for _, field in next, fields do\n\009\009\009theme[field] = Options[field].Value:ToHex()\n\009\009end\n\n\009\009writefile(self.Folder .. \'/themes/\' .. file .. \'.json\', httpService:JSONEncode(theme))\n\009end\n\n\009function ThemeManager:ReloadCustomThemes()\n\009\009local list = listfiles(self.Folder .. \'/themes\')\n\n\009\009local out = {}\n\009\009for i = 1, #list do\n\009\009\009local file = list[i]\n\009\009\009if file:sub(-5) == \'.json\' then\n\009\009\009\009-- i hate this but it has to be done ...\n\n\009\009\009\009local pos = file:find(\'.json\', 1, true)\n\009\009\009\009local char = file:sub(pos, pos)\n\n\009\009\009\009while char ~= \'/\' and char ~= \'\\\\\' and char ~= \'\' do\n\009\009\009\009\009pos = pos - 1\n\009\009\009\009\009char = file:sub(pos, pos)\n\009\009\009\009end\n\n\009\009\009\009if char == \'/\' or char == \'\\\\\' then\n\009\009\009\009\009table.insert(out, file:sub(pos + 1))\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\n\009\009return out\n\009end\n\n\009function ThemeManager:SetLibrary(lib)\n\009\009self.Library = lib\n\009\009lib.ThemeManager = self\n\009end\n\n\009function ThemeManager:BuildFolderTree()\n\009\009local paths = {}\n\n\009\009-- build the entire tree if a path is like some-hub/phantom-forces\n\009\009-- makefolder builds the entire tree on Synapse X but not other exploits\n\n\009\009local parts = self.Folder:split(\'/\')\n\009\009for idx = 1, #parts do\n\009\009\009paths[#paths + 1] = table.concat(parts, \'/\', 1, idx)\n\009\009end\n\n\00