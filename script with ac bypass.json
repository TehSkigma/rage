    end
    
    if not Config.Visuals.ShowCrosshair then return end
    
    local lines = {}
    local size = Config.Visuals.CrosshairSize
    local thickness = Config.Visuals.CrosshairThickness
    local color = Config.Visuals.CrosshairColor
    local style = Config.Visuals.CrosshairStyle
    
    if style == "dot" then
        local dot = Drawing.new("Circle")
        dot.Filled = true
        dot.Radius = thickness * 2
        dot.Color = color
        dot.Visible = true
        crosshair = {dot}
        return
