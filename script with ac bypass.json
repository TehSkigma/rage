-- ============================================================
-- SECTION 1: ANTI-CHEAT BYPASS (CORE)
-- ============================================================

local function acBypass()
    -- 1.1: Hook setmetatable to block __mode="kv" (anti-debug tables)
    local oldSetMeta = setmetatable
    local function newSetMeta(tbl, mt)
        if mt and type(mt) == "table" and rawget(mt, "__mode") == "kv" then
            local trace = debug.traceback()
            if trace:find("MiscellaneousController") then
                return oldSetMeta({}, nil)  -- Return empty table with no metatable
            end
        end
        return oldSetMeta(tbl, mt)
    end
    setmetatable = newSetMeta  -- Override globally

    -- 1.2: Disable script descendants that are anti-cheat related
    local function disableScripts()
        local tags = {"anticheat", "ac", "detection", "ban", "kick", "security", "moderation"}
        local function processObj(obj)
            if obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
                local name = obj.Name:lower()
                for _, tag in ipairs(tags) do
                    if name:find(tag) then
                        pcall(function() obj.Disabled = true end)
                        break
                    end
                end
            end
        end

        -- Process all existing descendants
        for _, child in ipairs(game:GetDescendants()) do
            processObj(child)
        end

        -- Connect for future descendants
        game.DescendantAdded:Connect(processObj)
    end

    -- 1.3: Monitor NetworkClient for incoming anti-cheat remotes
    local function monitorNetworkClient()
        local nc = game:GetService("NetworkClient")
        if not nc then return end
        nc.ChildAdded:Connect(function(child)
            local name = child.Name:lower()
            if name:find("anticheat") or name:find("detection") or name:find("kick") then
                pcall(function() child:Destroy() end)
            end
        end)
    end

    -- 1.4: Create a fake ClientAlert to satisfy the game's initial check
    local fakeAlert = Instance.new("RemoteEvent")
    fakeAlert.Name = "ClientAlert"
    fakeAlert.Parent = game.Players.LocalPlayer

    -- 1.5: Spoof WaitForChild on LocalPlayer to return our fake alert
    local meta = getrawmetatable(game.Players.LocalPlayer) or {}
    local oldNameCall = meta.__namecall
    setreadonly(meta, false)
    meta.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "WaitForChild" and select(1, ...) == "ClientAlert" then
            return fakeAlert
        end
        return oldNameCall(self, ...)
    end)
    setreadonly(meta, true)

    -- 1.6: Block Kick and Shutdown methods on LocalPlayer
    local playerMeta = getrawmetatable(game.Players.LocalPlayer)
    local oldPlayerNameCall = playerMeta.__namecall
    setreadonly(playerMeta, false)
    playerMeta.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "Kick" or method == "kick" or method == "Shutdown" then
            return nil  -- Silently block
        end
        if method == "FireServer" and self == fakeAlert then
            return nil  -- Block fire on our fake
        end
        return oldPlayerNameCall(self, ...)
    end)
    setreadonly(playerMeta, true)

    -- 1.7: Hook and neuter the actual anti-cheat function in LocalScript3
    local function neuterACSripts()
        local targetScript = game:GetService("ReplicatedFirst"):WaitForChild("LocalScript3", 10)
        local hookedCount = 0

        for _, func in ipairs(getgc(false)) do
            if type(func) == "function" then
                local success, env = pcall(getfenv, func)
                if success and env then
                    local scriptObj = rawget(env, "script")
                    if scriptObj and (scriptObj == targetScript or tostring(scriptObj):find("LoadingScreen")) then
                        local ok, constants = pcall(debug.getconstants, func)
                        if ok then
                            for _, const in ipairs(constants) do
                                if type(const) == "string" and (const:find("TakeTheL") or const:find("ban") or const:find("kick")) then
                                    hookfunction(func, function() end)
                                    hookedCount = hookedCount + 1
                                    break  -- Exit loop early to save performance
                                end
                            end
                        end
                    end
                end
            end
        end

        if hookedCount > 0 then
            print("[Bread] Neutered " .. hookedCount .. " anti-cheat functions.")
        else
            warn("[Bread] No anti-cheat functions found. Game may have updated.")
        end
    end

    -- Execute all bypass steps asynchronously
    coroutine.wrap(function()
        pcall(disableScripts)
        pcall(monitorNetworkClient)
        pcall(neuterACSripts)
        print("[Bread] Anti-cheat bypass initialized.")
    end)()
end

-- ============================================================
-- SECTION 2: COSMETIC UNLOCK ALL (GOD MODE)
-- ============================================================

local function unlockAll()
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local HttpService = game:GetService("HttpService")
    local player = Players.LocalPlayer
    local playerScripts = player.PlayerScripts
    local controllers = playerScripts:FindFirstChild("Controllers")
    if not controllers then return warn("[Bread] Controllers not found. Unlock all abort.") end

    -- 2.1: Load required modules with timeout
    local function safeRequire(path, timeout)
        timeout = timeout or 5
        local start = tick()
        while tick() - start < timeout do
            local success, mod = pcall(function() return require(path) end)
            if success and mod then return mod end
            task.wait(0.1)
        end
        return nil
    end

    local EnumLibrary = safeRequire(ReplicatedStorage.Modules:WaitForChild("EnumLibrary", 10))
    local CosmeticLibrary = safeRequire(ReplicatedStorage.Modules:WaitForChild("CosmeticLibrary", 10))
    local ItemLibrary = safeRequire(ReplicatedStorage.Modules:WaitForChild("ItemLibrary", 10))
    local DataController = safeRequire(controllers:WaitForChild("PlayerDataController", 10))

    if not (EnumLibrary and CosmeticLibrary and ItemLibrary and DataController) then
        return warn("[Bread] Critical modules missing. Unlock all failed.")
    end

    -- 2.2: State management
    local equipped = {}
    local favorites = {}
    local constructingWeapon = nil
    local viewingProfile = nil
    local lastUsedWeapon = nil

    -- 2.3: Clone cosmetic data safely
    local function cloneCosmetic(name, cosmeticType, options)
        if not CosmeticLibrary.Cosmetics then return nil end
        local base = CosmeticLibrary.Cosmetics[name]
        if not base then return nil end
        local data = {}
        for k, v in pairs(base) do data[k] = v end
        data.Name = name
        data.Type = data.Type or cosmeticType
        data.Seed = data.Seed or math.random(1, 1000000)
        if EnumLibrary and EnumLibrary.ToEnum then
            local success, enumId = pcall(EnumLibrary.ToEnum, EnumLibrary, name)
            if success and enumId then
                data.Enum = enumId
                data.ObjectID = data.ObjectID or enumId
            end
        end
        if options then
            if options.inverted ~= nil then data.Inverted = options.inverted end
            if options.favoritesOnly ~= nil then data.OnlyUseFavorites = options.favoritesOnly end
        end
        return data
    end

    -- 2.4: Config save/load with error handling
    local CONFIG_PATH = "CloakUnlockall/config.json"
    local function saveConfig()
        if not writefile then return end
        pcall(function()
            local config = {
                equipped = {},
                favorites = favorites or {}
            }
            for weapon, cosmetics in pairs(equipped) do
                config.equipped[weapon] = {}
                for cType, cData in pairs(cosmetics) do
                    if cData and cData.Name then
                        config.equipped[weapon][cType] = {
                            name = cData.Name,
                            seed = cData.Seed,
                            inverted = cData.Inverted
                        }
                    end
                end
            end
            makefolder("CloakUnlockall")
            writefile(CONFIG_PATH, HttpService:JSONEncode(config))
        end)
    end

    local function loadConfig()
        if not readfile or not isfile or not isfile(CONFIG_PATH) then return end
        pcall(function()
            local config = HttpService:JSONDecode(readfile(CONFIG_PATH))
            if config.equipped then
                for weapon, cosmetics in pairs(config.equipped) do
                    equipped[weapon] = {}
                    for cType, cData in pairs(cosmetics) do
                        local cloned = cloneCosmetic(cData.name, cType, {inverted = cData.inverted})
                        if cloned then
                            cloned.Seed = cData.seed or math.random(1, 1000000)
                            equipped[weapon][cType] = cloned
                        end
                    end
                end
            end
            favorites = config.favorites or {}
        end)
    end

    -- 2.5: Patch Ownership Functions
    local originalOwnsCosmetic = CosmeticLibrary.OwnsCosmetic
    CosmeticLibrary.OwnsCosmetic = function(self, inventory, name, weapon)
        if name and name:find("MISSING_") then
            return originalOwnsCosmetic(self, inventory, name, weapon)
        end
        if CosmeticLibrary.Cosmetics and CosmeticLibrary.Cosmetics[name] then
            return true  -- Only claim ownership if the cosmetic actually exists
        end
        return originalOwnsCosmetic(self, inventory, name, weapon)
    end

    CosmeticLibrary.OwnsCosmeticNormally = function() return true end
    CosmeticLibrary.OwnsCosmeticUniversally = function() return true end
    CosmeticLibrary.OwnsCosmeticForWeapon = function() return true end

    -- 2.6: Patch DataController.Get
    local originalGet = DataController.Get
    DataController.Get = function(self, key)
        local data = originalGet(self, key)
        if key == "CosmeticInventory" then
            local proxy = {}
            if data then
                for k, v in pairs(data) do proxy[k] = v end
            end
            return setmetatable(proxy, {
                __index = function(tbl, index)
                    if CosmeticLibrary.Cosmetics and CosmeticLibrary.Cosmetics[index] then
                        return true
                    end
                    return nil  -- Don't lie about non-existent cosmetics
                end
            })
        end
        if key == "FavoritedCosmetics" then
            local result = data and table.clone(data) or {}
            for weapon, favs in pairs(favorites) do
                result[weapon] = result[weapon] or {}
                for name, isFav in pairs(favs) do
                    result[weapon][name] = isFav
                end
            end
            return result
        end
        return data
    end

    -- 2.7: Patch GetWeaponData
    local originalGetWeaponData = DataController.GetWeaponData
    DataController.GetWeaponData = function(self, weaponName)
        local data = originalGetWeaponData(self, weaponName)
        if not data then return nil end
        local merged = {}
        for k, v in pairs(data) do merged[k] = v end
        merged.Name = weaponName
        if equipped[weaponName] then
            for cType, cData in pairs(equipped[weaponName]) do
                merged[cType] = cData
            end
        end
        return merged
    end

    -- 2.8: Hook Remote Events
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local dataRemotes = remotes and remotes:FindFirstChild("Data")
    local equipRemote = dataRemotes and dataRemotes:FindFirstChild("EquipCosmetic")
    local favoriteRemote = dataRemotes and dataRemotes:FindFirstChild("FavoriteCosmetic")
    local replicationRemotes = remotes and remotes:FindFirstChild("Replication")
    local fighterRemotes = replicationRemotes and replicationRemotes:FindFirstChild("Fighter")
    local useItemRemote = fighterRemotes and fighterRemotes:FindFirstChild("UseItem")

    if equipRemote and hookfunction then
        local originalFireServer = equipRemote.FireServer
        hookfunction(equipRemote, function(self, weaponName, cosmeticType, cosmeticName, options)
            if cosmeticName and cosmeticName ~= "None" and cosmeticName ~= "" then
                local inventory = DataController:Get("CosmeticInventory")
                if inventory and rawget(inventory, cosmeticName) then
                    return originalFireServer(self, weaponName, cosmeticType, cosmeticName, options)
                end
            end

            equipped[weaponName] = equipped[weaponName] or {}
            if not cosmeticName or cosmeticName == "None" or cosmeticName == "" then
                equipped[weaponName][cosmeticType] = nil
                if not next(equipped[weaponName]) then equipped[weaponName] = nil end
            else
                local cloned = cloneCosmetic(cosmeticName, cosmeticType, {
                    inverted = options and options.IsInverted,
                    favoritesOnly = options and options.OnlyUseFavorites
                })
                if cloned then
                    equipped[weaponName][cosmeticType] = cloned
                end
            end

            task.defer(function()
                pcall(function()
                    DataController.CurrentData:Replicate("WeaponInventory")
                    task.wait(0.2)
                    saveConfig()
                end)
            end)
        end)
    end

    if favoriteRemote and hookfunction then
        hookfunction(favoriteRemote, function(self, weapon, name, isFav)
            favorites[weapon] = favorites[weapon] or {}
            favorites[weapon][name] = isFav or nil
            saveConfig()
            task.spawn(function()
                pcall(function() DataController.CurrentData:Replicate("FavoritedCosmetics") end)
            end)
        end)
    end

    -- 2.9: Patch ViewModel Creation for Skin/Wrap/Charm rendering
    local ClientItem = safeRequire(player.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem)
    if ClientItem and ClientItem._CreateViewModel then
        local originalCreate = ClientItem._CreateViewModel
        ClientItem._CreateViewModel = function(self, viewmodelRef)
            local weaponName = self.Name
            local weaponPlayer = self.ClientFighter and self.ClientFighter.Player
            constructingWeapon = (weaponPlayer == player) and weaponName or nil

            if weaponPlayer == player and equipped[weaponName] and equipped[weaponName].Skin and viewmodelRef then
                local dataKey = self:ToEnum and self:ToEnum("Data") or "Data"
                local skinKey = self:ToEnum and self:ToEnum("Skin") or "Skin"
                local nameKey = self:ToEnum and self:ToEnum("Name") or "Name"
                if viewmodelRef[dataKey] then
                    viewmodelRef[dataKey][skinKey] = equipped[weaponName].Skin
                    viewmodelRef[dataKey][nameKey] = equipped[weaponName].Skin.Name
                elseif viewmodelRef.Data then
                    viewmodelRef.Data.Skin = equipped[weaponName].Skin
                    viewmodelRef.Data.Name = equipped[weaponName].Skin.Name
                end
            end

            local result = originalCreate(self, viewmodelRef)
            constructingWeapon = nil
            return result
        end
    end

    -- 2.10: Load saved configuration
    loadConfig()
    print("[Bread] Unlock All activated. All cosmetics are now yours.")
end

-- ============================================================
-- SECTION 3: EXECUTE EVERYTHING
-- ============================================================

coroutine.wrap(function()
    -- Wait for game to fully load
    task.wait(3)
    
    pcall(acBypass)
    pcall(unlockAll)

    -- UI Animation (optional cleanup)
    local soundService = game:GetService("SoundService")
    local loadSound = Instance.new("Sound", soundService)
    loadSound.SoundId = "rbxassetid://17148249625"
    loadSound.Volume = 0.5
    pcall(function() loadSound:Play() end)

    print("[Bread] All systems operational. Enjoy your god-tier cosmetics.")
end)()
