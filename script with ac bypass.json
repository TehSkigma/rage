-- ====================================================================
-- ENVIRONMENT SETUP
-- ====================================================================

local function setupEnvironment()
    if not hookfunction then
        hookfunction = function(func, replacement) return replacement end
    end
    if not newcclosure then
        newcclosure = function(func) return func end
    end
    if not getrenv then
        getrenv = function() return getfenv() end
    end
    if not getgenv then
        getgenv = function() return _G end
    end
    if not cloneref then
        cloneref = function(obj) return obj end
    end
end
setupEnvironment()

-- ====================================================================
-- ANTI-DETECTION SYSTEM
-- ====================================================================

local hookFunc = hookfunction((getrenv()).setmetatable, newcclosure(function(N, r)
    if r and typeof(r) == "table" and rawget(r, "__mode") == "kv" then
        local trace = debug.traceback()
        if trace:find("MiscellaneousController") then
            return hookFunc({1, 2, 3}, {})
        end
    end
    return hookFunc(N, r)
end))

coroutine.wrap(function()
    pcall(function()
        local function scanAndDisable(instance)
            pcall(function()
                if instance:IsA("LocalScript") or instance:IsA("ModuleScript") then
                    local success, name = pcall(function() return instance.Name:lower() end)
                    if success and name then
                        local keywords = {"anticheat", "ac", "detection", "ban", "kick", "security", "moderation"}
                        for _, keyword in ipairs(keywords) do
                            if name:find(keyword) then
                                pcall(function() instance.Disabled = true end)
                                break
                            end
                        end
                    end
                end
            end)
        end
        
        for _, obj in ipairs(game:GetDescendants()) do
            scanAndDisable(obj)
        end
        
        game.DescendantAdded:Connect(scanAndDisable)
    end)
    
    pcall(function()
        local network = game:GetService("NetworkClient")
        if network then
            network.ChildAdded:Connect(function(child)
                pcall(function()
                    local success, name = pcall(function() return child.Name:lower() end)
                    if success and name and (name:find("anticheat") or name:find("detection")) then
                        pcall(function() child:Destroy() end)
                    end
                end)
            end)
        end
    end)
end)()

