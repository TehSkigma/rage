-- ====================================================================
-- ANTI-DETECTION SYSTEM
-- ====================================================================

local function setupAntiDetection()
    if not Config.AntiDetection.Enabled then return end
    
    if Config.AntiDetection.HookMetatables then
        pcall(function()
            local oldMetatable = getrenv and getrenv().setmetatable or setmetatable
            if hookfunction then
                hookfunction(oldMetatable, function(obj, meta)
                    if meta and type(meta) == "table" and rawget(meta, "__mode") == "kv" then
                        local trace = debug and debug.traceback and debug.traceback() or ""
                        if trace:find("MiscellaneousController") or trace:find("AntiCheat") or trace:find("Moderation") then
                            return oldMetatable({}, {})
                        end
                    end
                    return oldMetatable(obj, meta)
                end)
            end
        end)
    end
    
    if Config.AntiDetection.ScanScripts then
        pcall(function()
            local keywords = {"anticheat", "ac", "detection", "ban", "kick", "security", "moderation", "admin", "staff", "mod"}
            for _, obj in ipairs(game:GetDescendants()) do
                if obj:IsA("LocalScript") or obj:IsA("ModuleScript") or obj:IsA("Script") then
                    local name = pcall(obj.Name.lower, obj) and obj.Name:lower() or ""
                    for _, kw in ipairs(keywords) do
                        if name:find(kw) then
                            pcall(function() 
                                obj.Disabled = true 
                                if obj:IsA("ModuleScript") then
                                    obj.Parent = nil
                                end
                            end)
                            break
                        end
                    end
                end
                if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                    local name = pcall(obj.Name.lower, obj) and obj.Name:lower() or ""
                    for _, kw in ipairs({"anticheat", "ac", "detection", "ban", "kick"}) do
                        if name:find(kw) then
                            pcall(function() obj:Destroy() end)
                            break
                        end
                    end
                end
            end
        end)
    end
end

setupAntiDetection()
print("[RIVALS] Anti-detection active")

-- ====================================================================
-- UTILITY FUNCTIONS
-- ====================================================================

local function getCharacter(player)
    if not player then return nil end
    return player.Character
end

local function getHumanoid(player)
    local char = getCharacter(player)
    if char then return char:FindFirstChildOfClass("Humanoid") end
    return nil
end

local function getPart(player, partName)
    local char = getCharacter(player)
    if not char then return nil end
    return char:FindFirstChild(partName) or char:FindFirstChild("HumanoidRootPart")
end

local function isAlive(player)
    local hum = getHumanoid(player)
    return hum and hum.Health > 0
end

local function getHealth(player)
    local hum = getHumanoid(player)
    return hum and hum.Health or 0
end

local function getMaxHealth(player)
    local hum = getHumanoid(player)
    return hum and hum.MaxHealth or 100
end

local function getDistance(player)
    local char1 = LocalPlayer.Character
    local char2 = getCharacter(player)
    if not char1 or not char2 then return math.huge end
    local hrp1 = char1:FindFirstChild("HumanoidRootPart")
    local hrp2 = char2:FindFirstChild("HumanoidRootPart")
    if hrp1 and hrp2 then
        return (hrp1.Position - hrp2.Position).Magnitude
    end
    return math.huge
end

local function isVisible(part)
    if not part or not Camera then return false end
    local origin = Camera.CFrame.Position
    local dir = (part.Position - origin).Unit
    local dist = (part.Position - origin).Magnitude
    local params = RaycastParams.new()
    local char = LocalPlayer.Character
    if char then params.FilterDescendantsInstances = {char} end
    params.FilterType = Enum.RaycastFilterType.Blacklist
    local result = Workspace:Raycast(origin, dir * dist, params)
    return result == nil
end

local function getScreenPos(part)
    if not part or not Camera then return nil end
    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
    if onScreen then return Vector2.new(pos.X, pos.Y) end
    return nil
end

local function getTeam(player)
    if not player then return nil end
    return player:GetAttribute("TeamID") or player.Team
end

local function isTeammate(player)
    if not Config.ESP.TeamCheck then return false end
    local localTeam = getTeam(LocalPlayer)
    local targetTeam = getTeam(player)
    return localTeam and targetTeam and localTeam == targetTeam
end

local function lerp(a, b, t)
    return a + (b - a) * t
end

local function lerpColor(c1, c2, t)
    return Color3.new(
        lerp(c1.R, c2.R, t),
        lerp(c1.G, c2.G, t),
        lerp(c1.B, c2.B, t)
    )
end

local function createText(text, pos, color, size)
    local txt = Drawing.new("Text")
    txt.Text = text
    txt.Position = pos
    txt.Color = color or Color3.fromRGB(255, 255, 255)
    txt.Size = size or 14
    txt.Outline = true
    txt.OutlineColor = Color3.fromRGB(0, 0, 0)
    txt.Center = true
    txt.Font = 2
    txt.Visible = true
    return txt
end

-- ====================================================================
-- PLAYER TRACKING
-- ====================================================================

local function trackPlayers()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = getCharacter(player)
            if char then
                if not trackedPlayers[player] then
                    trackedPlayers[player] = {
                        Name = player.Name,
                        DisplayName = player.DisplayName,
                        Character = char,
                        RootPart = char:FindFirstChild("HumanoidRootPart"),
                        Head = char:FindFirstChild("Head"),
                        Health = char:FindFirstChildOfClass("Humanoid"),
                        LastPosition = Vector3.new(0, 0, 0),
                        Velocity = Vector3.new(0, 0, 0),
                        Team = getTeam(player),
                        LastSeen = tick(),
                        HasKatana = false,
                    }
                end
                local data = trackedPlayers[player]
                if data.Character and data.RootPart then
                    local currentPos = data.RootPart.Position
                    local dt = 0.1
                    if data.LastPosition and data.LastPosition ~= Vector3.new(0, 0, 0) then
                        data.Velocity = (currentPos - data.LastPosition) / dt
                    end
                    data.LastPosition = currentPos
                    data.LastSeen = tick()
                    
                    -- Check for katana
                    for _, child in ipairs(char:GetChildren()) do
                        if child:IsA("Tool") and (child.Name:lower():find("katana") or child.Name:lower():find("sword")) then
                            data.HasKatana = true
                            break
                        end
                    end
                end
            else
                if trackedPlayers[player] then
                    trackedPlayers[player].LastSeen = tick()
                end
            end
        end
    end
end

-- ====================================================================
-- ESP SYSTEM
-- ====================================================================

local function updateESP()
    if not Config.ESP.Enabled then
        for player, data in pairs(espHighlights) do
            pcall(function() data:Destroy() end)
            espHighlights[player] = nil
        end
        for player, data in pairs(espBoxes) do
            pcall(function() data:Remove() end)
            espBoxes[player] = nil
        end
        for player, data in pairs(espTexts) do
            pcall(function() data:Remove() end)
            espTexts[player] = nil
        end
        return
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not isTeammate(player) then
            local char = getCharacter(player)
            if char and isAlive(player) then
                local dist = getDistance(player)
                if dist <= Config.ESP.MaxDistance then
                    -- Highlight
                    if not espHighlights[player] then
                        local highlight = Instance.new("Highlight")
                        highlight.FillColor = Config.ESP.Color
                        highlight.OutlineColor = Config.ESP.OutlineColor
                        highlight.FillTransparency = Config.ESP.Transparency
                        highlight.OutlineTransparency = Config.ESP.OutlineTransparency
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.Adornee = char
                        highlight.Parent = char
                        espHighlights[player] = highlight
                    end
                    
                    -- Box
                    if Config.ESP.ShowBoxes then
                        if not espBoxes[player] then
                            local box = Drawing.new("Square")
                            box.Thickness = 1
                            box.Color = Config.ESP.Color
                            box.Filled = false
                            box.Visible = true
                            espBoxes[player] = box
                        end
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        local head = char:FindFirstChild("Head")
                        if hrp and head then
                            local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position)
                            local footPos, footOnScreen = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 2, 0))
                            if headOnScreen and footOnScreen then
                                local height = math.abs(headPos.Y - footPos.Y)
                                local width = height * 0.5
                                local centerX = (headPos.X + footPos.X) / 2
                                local box = espBoxes[player]
                                box.Position = Vector2.new(centerX - width/2, footPos.Y)
                                box.Size = Vector2.new(width, height)
                                box.Visible = true
                            end
                        end
                    else
                        if espBoxes[player] then
                            espBoxes[player].Visible = false
                        end
                    end
                    
                    -- Text
                    if Config.ESP.ShowName or Config.ESP.ShowDistance then
                        if not espTexts[player] then
                            local txt = Drawing.new("Text")
                            txt.Size = 13
                            txt.Outline = true
                            txt.OutlineColor = Color3.fromRGB(0, 0, 0)
                            txt.Center = true
                            txt.Visible = true
                            espTexts[player] = txt
                        end
                        local head = char:FindFirstChild("Head")
                        if head then
                            local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                            if onScreen then
                                local txt = espTexts[player]
                                local text = ""
                                if Config.ESP.ShowName then
                                    text = player.DisplayName or player.Name
                                end
                                if Config.ESP.ShowDistance then
                                    if text ~= "" then text = text .. " | " end
                                    text = text .. math.floor(dist) .. "m"
                                end
                                txt.Text = text
                                txt.Position = Vector2.new(pos.X, pos.Y - 30)
                                txt.Color = Config.ESP.Color
                                txt.Size = 13
                                txt.Visible = true
                            end
                        end
                    end
                else
                    if espHighlights[player] then
                        pcall(function() espHighlights[player]:Destroy() end)
                        espHighlights[player] = nil
                    end
                    if espBoxes[player] then
                        pcall(function() espBoxes[player]:Remove() end)
                        espBoxes[player] = nil
                    end
                    if espTexts[player] then
                        pcall(function() espTexts[player]:Remove() end)
                        espTexts[player] = nil
                    end
                end
            else
                if espHighlights[player] then
                    pcall(function() espHighlights[player]:Destroy() end)
                    espHighlights[player] = nil
                end
                if espBoxes[player] then
                    pcall(function() espBoxes[player]:Remove() end)
                    espBoxes[player] = nil
                end
                if espTexts[player] then
                    pcall(function() espTexts[player]:Remove() end)
                    espTexts[player] = nil
                end
            end
        end
    end
end

-- ====================================================================
-- FOV CIRCLE (Aimbot)
-- ====================================================================

local function createFOVCircle()
    if fovCircle then
        pcall(function() fovCircle:Remove() end)
        fovCircle = nil
    end
    
    if not Config.Visuals.ShowFOV then return end
    
    local circle = Drawing.new("Circle")
    circle.Thickness = 1.5
    circle.NumSides = 36
    circle.Filled = false
    circle.Color = Config.Visuals.FOVColor
    circle.Transparency = Config.Visuals.FOVTransparency
    circle.Radius = Config.Visuals.FOVRadius
    circle.Visible = true
    fovCircle = circle
end

local function updateFOVCircle()
    if not fovCircle then return end
    local mousePos = UserInputService:GetMouseLocation()
    fovCircle.Position = Vector2.new(mousePos.X, mousePos.Y)
end

