local function toggleAimbot()
    Config.Aimbot.Enabled = not Config.Aimbot.Enabled
    print("Aimbot: " .. tostring(Config.Aimbot.Enabled))
end

local function toggleESP()
    Config.ESP.Enabled = not Config.ESP.Enabled
    print("ESP: " .. tostring(Config.ESP.Enabled))
end

local function toggleSilentAim()
    Config.SilentAim.Enabled = not Config.SilentAim.Enabled
    print("Silent Aim: " .. tostring(Config.SilentAim.Enabled))
end

local function toggleSpeed()
    Config.Speed.Enabled = not Config.Speed.Enabled
    print("Speed: " .. tostring(Config.Speed.Enabled))
end

local function toggleAntiAim()
    Config.AntiAim.Enabled = not Config.AntiAim.Enabled
    print("Anti-Aim: " .. tostring(Config.AntiAim.Enabled))
end

local function toggleRagebot()
    Ragebot.Enabled = not Ragebot.Enabled
    print("Ragebot: " .. tostring(Ragebot.Enabled))
    if not Ragebot.Enabled then
        if targetIndicator then
            targetIndicator:Destroy()
            targetIndicator = nil
        end
        if RagebotData.FOVCircle then
            RagebotData.FOVCircle:Remove()
            RagebotData.FOVCircle = nil
        end
        RagebotData.CurrentTarget = nil
    end
end

