local function toggleAimbot(value)
    Config.Aimbot.Enabled = value
    print("[RIVALS] Aimbot: " .. tostring(value))
end

local function toggleESP(value)
    Config.ESP.Enabled = value
    print("[RIVALS] ESP: " .. tostring(value))
end

local function toggleSilentAim(value)
    Config.SilentAim.Enabled = value
    print("[RIVALS] Silent Aim: " .. tostring(value))
end

local function toggleSpeed(value)
    Config.Speed.Enabled = value
    print("[RIVALS] Speed: " .. tostring(value))
end

local function toggleAntiAim(value)
    Config.AntiAim.Enabled = value
    print("[RIVALS] Anti-Aim: " .. tostring(value))
end

local function toggleRagebot(value)
    Config.Ragebot.Enabled = value
    print("[RIVALS] Ragebot: " .. tostring(value))
    if not value then
        ragebotTarget = nil
        ragebotTargetPart = nil
        if ragebotFOVCircle then
            pcall(function() ragebotFOVCircle:Remove() end)
            ragebotFOVCircle = nil
        end
        if targetIndicator then
            pcall(function() targetIndicator:Destroy() end)
            targetIndicator = nil
        end
    else
        createRagebotFOVCircle()
    end
end

