lider\', idx = idx, value = object.Value }\n\009\009\009end,\n\009\009\009Load = function(idx, data)\n\009\009\009\009if Options[idx] then \n\009\009\009\009\009Options[idx]:SetValue(data.value)\n\009\009\009\009end\n\009\009\009end,\n\009\009},\n\n\009\009Dropdown = {\n\009\009\009Save = function(idx, object)\n\009\009\009\009return { type = \'Dropdown\', idx = idx, value = object.Value, multi = object.Multi }\n\009\009\009end,\n\009\009\009Load = function(idx, data)\n\009\009\009\009if Options[idx] then \n\009\009\009\009\009Options[idx]:SetValue(data.value)\n\009\009\009\009end\n\009\009\009end,\n\009\009},\n\n\009\009ColorPicker = {\n\009\009\009Save = function(idx, object)\n\009\009\009\009return { \n\009\009\009\009\009type = \'ColorPicker\', \n\009\009\009\009\009idx = idx, \n\009\009\009\009\009value = object.Value:ToHex(), \n\009\009\009\009\009transparency = object.Transparency \n\009\009\009\009}\n\009\009\009end,\n\009\009\009Load = function(idx, data)\n\009\009\009\009if Options[idx] then \n\009\009\009\009\009Options[idx]:SetValueRGB(Color3.fromHex(data.value or \"FFFFFF\"), data.transparency or 0)\n\009\009\009\009end\n\009\009\009end,\n\009\009},\n\n\009\009KeyPicker = {\n\009\009\009Save = function(idx, object) \n\009\009\009\009return { \n\009\009\009\009\009type = \'KeyPicker\', \n\009\009\009\009\009idx = idx, \n\009\009\009\009\009key = object.Value or \"None\",\n\009\009\009\009\009mode = object.Mode or \"Toggle\",\n\009\009\009\009\009toggled = object.Toggled or false,\n\009\009\009\009\009syncToggleState = object.SyncToggleState or false\n\009\009\009\009} \n\009\009\009end,\n\009\009\009Load = function(idx, data)\n\009\009\009\009if Options[idx] then \n\009\009\009\009\009if Options[idx].SetValue then\n\009\009\009\009\009\009if type(Options[idx].SetValue) == \"function\" then\n\009\009\009\009\009\009\009Options[idx]:SetValue({ data.key, data.mode })\n\009\009\009\009\009\009else\n\009\009\009\009\009\009\009Options[idx].Value = data.key\n\