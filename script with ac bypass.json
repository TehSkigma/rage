-- ====================================================================

local function setupEnvironment()
    if not hookfunction then
        hookfunction = function(func, replacement) return replacement end
    end
    if not newcclosure then
        newcclosure = function(func) return func end
    end
    if not getrenv then
        getrenv = function() return getfenv() end
    end
    if not getgenv then
        getgenv = function() return _G end
    end
    if not cloneref then
        cloneref = function(obj) return obj end
    end
    if not isfolder then
        isfolder = function() return false end
        makefolder = function() end
        writefile = function() end
        readfile = function() return "" end
        delfile = function() end
        listfiles = function() return {} end
    end
    if not getsynasset then
        getsynasset = function(path) return path end
    end
    if not getcustomasset then
        getcustomasset = function(path) return path end
    end
    if not gethui then
        gethui = function() return game:GetService("CoreGui") end
    end
    if not getgc then
        getgc = function() return {} end
    end
    if not setfpscap then
        setfpscap = function() end
    end
    if not getfenv then
        getfenv = function() return _G end
    end
end
setupEnvironment()

