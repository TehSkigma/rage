    -- 1.5 & 1.6: Spoof WaitForChild and block Kick/Shutdown
    pcall(function()
        local player = game:GetService("Players").LocalPlayer
        if not player then return end
        
        local meta = getrawmetatable(player)
        if meta then
            local oldNameCall = meta.__namecall
            if oldNameCall then
                setreadonly(meta, false)
                meta.__namecall = newcclosure(function(self, ...)
                    local method = getnamecallmethod() or "__namecall"
                    if method == "WaitForChild" and select(1, ...) == "ClientAlert" and fakeAlert then
                        return fakeAlert
                    end
                    if method == "Kick" or method == "kick" or method == "Shutdown" then
                        return nil
                    end
                    if method == "FireServer" and self == fakeAlert then
