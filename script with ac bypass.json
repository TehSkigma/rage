-- 0.1: Safe function wrappers to prevent "nil value" errors
local function safeCall(func, ...)
    if type(func) ~= "function" then return nil end
    local success, result = pcall(func, ...)
    if not success then
        warn("[SafeCall] Error: " .. tostring(result))
        return nil
    end
    return result
end

-- 0.2: Universal hookfunction support
local hookfunction = hookfunction or 
    (debug and debug.hookfunction) or 
    (syn and syn.hookfunction) or 
    function(f, h) 
        local old = f
        rawset(f, "__hook", h)
        return old 
    end

-- 0.3: Universal getrawmetatable support
local getrawmetatable = getrawmetatable or 
    (debug and debug.getrawmetatable) or 
    function(obj) 
        return getmetatable(obj) 
    end

-- 0.4: Universal setreadonly support
local setreadonly = setreadonly or 
    (debug and debug.setreadonly) or 
    function(tbl, bool) 
        if bool then 
            rawset(tbl, "__readonly", true) 
        else 
            rawset(tbl, "__readonly", nil) 
        end 
    end

-- 0.5: Universal getnamecallmethod support
local getnamecallmethod = getnamecallmethod or 
    (debug and debug.getnamecallmethod) or 
    function() 
        return "__namecall" 
    end

-- 0.6: Universal newcclosure support (for anonymous functions)
local newcclosure = newcclosure or 
    (debug and debug.newcclosure) or 
    function(f) 
        return f 
    end

-- 0.7: Universal getgc support
local getgc = getgc or 
    (debug and debug.getgc) or 
    function() 
        return {} 
    end

-- 0.8: Universal getfenv support
local getfenv = getfenv or 
    (debug and debug.getfenv) or 
    function(f) 
        return _G 
    end

-- 0.9: Universal getconstants support
local getconstants = debug and debug.getconstants or 
    function() 
        return {} 
    end

-- 0.10: Universal isfile/readfile/writefile support with graceful fallbacks
local function safeFileOperation(op, ...)
    local funcMap = {
        isfolder = isfolder,
        makefolder = makefolder,
        isfile = isfile,
        readfile = readfile,
        writefile = writefile,
    }
    local fn = funcMap[op]
    if not fn then return false end
    local success, result = pcall(fn, ...)
    if not success then return false end
    return result
end

