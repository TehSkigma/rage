    end)

    -- 1.7: Hook and neuter the actual anti-cheat function in LocalScript3
    local function neuterACSripts()
        pcall(function()
            local replicatedFirst = game:GetService("ReplicatedFirst")
            if not replicatedFirst then return end
            
            local targetScript = replicatedFirst:FindFirstChild("LocalScript3")
