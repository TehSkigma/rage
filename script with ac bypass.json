-- ====================================================================
-- AIMBOT
-- ====================================================================

local function getClosestPlayerToCursor()
    local mousePos = UserInputService:GetMouseLocation()
    local closest = nil
    local closestDist = Config.Aimbot.FOV
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) then
            if isTeammate(player) then continue end
            local dist = getDistance(player)
            if dist <= Config.Aimbot.MaxDistance then
                local targetPart = getPart(player, Config.Aimbot.HitPart) or getPart(player, "Head")
                if targetPart then
                    if Config.Aimbot.VisibleCheck and not isVisible(targetPart) then continue end
                    local screenPos = getScreenPos(targetPart)
                    if screenPos then
                        local screenDist = (screenPos - mousePos).Magnitude
                        if screenDist < closestDist then
                            closestDist = screenDist
                            closest = player
                        end
                    end
                end
            end
        end
    end
    
    return closest
end

local function getClosestPlayer()
    local closest = nil
    local closestDist = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) then
            if isTeammate(player) then continue end
            local dist = getDistance(player)
            if dist <= Config.Aimbot.MaxDistance and dist < closestDist then
                closestDist = dist
                closest = player
            end
        end
    end
    
    return closest
end

local function getLowestHealthPlayer()
    local lowest = nil
    local lowestHealth = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) then
            if isTeammate(player) then continue end
            local health = getHealth(player)
            if health < lowestHealth then
                lowestHealth = health
                lowest = player
            end
        end
    end
    
    return lowest
end

local function getAimbotTarget()
    if Config.Aimbot.TargetMode == "cursor" then
        return getClosestPlayerToCursor()
    elseif Config.Aimbot.TargetMode == "closest" then
        return getClosestPlayer()
    elseif Config.Aimbot.TargetMode == "lowest_health" then
        return getLowestHealthPlayer()
    end
    return nil
end

local function doAimbot()
    if not Config.Aimbot.Enabled then return end
    
    local target = getAimbotTarget()
    if target then
        local targetPart = getPart(target, Config.Aimbot.HitPart) or getPart(target, "Head")
        if targetPart then
            local targetPos = targetPart.Position
            
            -- Prediction
            if Config.Aimbot.Prediction then
                local data = trackedPlayers[target]
                if data and data.Velocity then
                    targetPos = targetPos + (data.Velocity * Config.Aimbot.PredictionMultiplier)
                end
            end
            
            local targetCF = CFrame.new(Camera.CFrame.Position, targetPos)
            Camera.CFrame = Camera.CFrame:Lerp(targetCF, Config.Aimbot.Smoothing)
            Camera.CameraType = Enum.CameraType.Scriptable
            
            -- Auto fire
            if Config.Aimbot.AutoFire then
                -- Fire weapon (would need weapon integration)
            end
        end
    end
end

