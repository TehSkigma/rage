-- ====================================================================
-- UTILITY FUNCTIONS
-- ====================================================================

local function getCharacter(player)
    if not player then return nil end
    return player.Character
end

local function getHumanoid(player)
    local char = getCharacter(player)
    if char then return char:FindFirstChildOfClass("Humanoid") end
    return nil
end

local function getPart(player, partName)
    local char = getCharacter(player)
    if not char then return nil end
    return char:FindFirstChild(partName)
end

local function isAlive(player)
    local hum = getHumanoid(player)
    if hum and hum.Health > 0 then return true end
    return false
end

local function getHealth(player)
    local hum = getHumanoid(player)
    if hum then return hum.Health end
    return 0
end

local function getMaxHealth(player)
    local hum = getHumanoid(player)
    if hum then return hum.MaxHealth end
    return 100
end

local function getDistanceToPlayer(player)
    local char1 = LocalPlayer.Character
    local char2 = getCharacter(player)
    if not char1 or not char2 then return math.huge end
    
    local hrp1 = char1:FindFirstChild("HumanoidRootPart")
    local hrp2 = char2:FindFirstChild("HumanoidRootPart")
    
    if hrp1 and hrp2 then
        return (hrp1.Position - hrp2.Position).Magnitude
    end
    return math.huge
end

local function isVisible(part)
    if not part or not Camera then return false end
    
    local origin = Camera.CFrame.Position
    local direction = (part.Position - origin).Unit
    local distance = (part.Position - origin).Magnitude
    
    local rayParams = RaycastParams.new()
    local char = LocalPlayer.Character
    if char then
        rayParams.FilterDescendantsInstances = {char}
    end
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    
    local result = Workspace:Raycast(origin, direction * distance, rayParams)
    return result == nil
end

local function getScreenPosition(part)
    if not part or not Camera then return nil end
    local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
    if onScreen then
        return Vector2.new(screenPos.X, screenPos.Y)
    end
    return nil
end

-- ====================================================================
-- PLAYER TRACKING
-- ====================================================================

local function trackPlayers()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if not trackedPlayers[player] then
                trackedPlayers[player] = {
                    Name = player.Name,
                    Character = player.Character,
                    RootPart = player.Character:FindFirstChild("HumanoidRootPart"),
                    Head = player.Character:FindFirstChild("Head"),
                    Health = player.Character:FindFirstChildOfClass("Humanoid"),
                    LastPosition = Vector3.new(0, 0, 0),
                    Velocity = Vector3.new(0, 0, 0),
                }
            end
            local data = trackedPlayers[player]
            if data.Character and data.RootPart then
                local currentPos = data.RootPart.Position
                data.Velocity = (currentPos - data.LastPosition) / 0.1
                data.LastPosition = currentPos
            end
        end
    end
end

-- ====================================================================
-- ESP
-- ====================================================================

local function createESP(player)
    if espObjects[player] then return end
    
    local character = getCharacter(player)
    if not character then return end
    
    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = character
    highlight.Parent = character
    
    espObjects[player] = { Highlight = highlight }
end

local function updateESP()
    if not Config.ESP.Enabled then
        for player, data in pairs(espObjects) do
            pcall(function() data.Highlight:Destroy() end)
            espObjects[player] = nil
        end
        return
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if player.Character then
                if not espObjects[player] then
                    createESP(player)
                end
            else
                if espObjects[player] then
                    pcall(function() espObjects[player].Highlight:Destroy() end)
                    espObjects[player] = nil
                end
            end
        end
    end
end

-- ====================================================================
-- AIMBOT
-- ====================================================================

local function getTargetCFrame(targetPlayer)
    local character = getCharacter(targetPlayer)
    if not character then return nil end
    
    local head = character:FindFirstChild(Config.Aimbot.HitPart) or character:FindFirstChild("Head")
    if not head then return nil end
    
    local targetPos = head.Position
    if Config.Aimbot.Prediction then
        local data = trackedPlayers[targetPlayer]
        if data and data.Velocity then
            targetPos = targetPos + (data.Velocity * Config.Aimbot.PredictionMultiplier)
        end
    end
    
    return CFrame.new(Camera.CFrame.Position, targetPos)
end

local function smoothAim(targetCFrame)
    if not targetCFrame then return end
    local currentCF = Camera.CFrame
    Camera.CFrame = currentCF:Lerp(targetCFrame, Config.Aimbot.Smoothing)
    Camera.CameraType = Enum.CameraType.Scriptable
end

local function getClosestPlayerToCursor()
    local mousePos = UserInputService:GetMouseLocation()
    local closest = nil
    local closestDist = Config.Aimbot.FOV
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild(Config.Aimbot.HitPart) or 
                        player.Character:FindFirstChild("Head")
            if head then
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closest = player
                    end
                end
            end
        end
    end
    
    return closest
end

-- ====================================================================
-- SPEED
-- ====================================================================

local function setSpeed(speed)
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = speed
    end
end

-- ====================================================================
-- ANTI-AIM
-- ====================================================================

local function antiAim()
    if not Config.AntiAim.Enabled then return end
    
    local character = LocalPlayer.Character
    if not character then return end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local angles = {
        jitter = CFrame.Angles(0, math.rad(Config.AntiAim.Angle * math.sin(tick() * Config.AntiAim.Speed)), 0),
        spin = CFrame.Angles(0, tick() * Config.AntiAim.Speed, 0),
        static = CFrame.Angles(0, math.rad(Config.AntiAim.Angle), 0),
    }
    
    local angle = angles[Config.AntiAim.Mode] or angles.jitter
    hrp.CFrame = hrp.CFrame * angle
end

-- ====================================================================
-- FOV CIRCLE
-- ====================================================================

local function createFOVCircle()
    if fovCircle then
        fovCircle:Remove()
        fovCircle = nil
    end
    
    if not Config.Visuals.FOVCircle then return end
    
    fovCircle = Drawing.new("Circle")
    fovCircle.Thickness = 1.5
    fovCircle.NumSides = 36
    fovCircle.Filled = false
    fovCircle.Color = Config.Visuals.FOVColor
    fovCircle.Transparency = 0.5
    fovCircle.Radius = Config.Visuals.FOVRadius
    fovCircle.Visible = true
end

local function updateFOVCircle()
    if not fovCircle then return end
    local mousePos = UserInputService:GetMouseLocation()
    fovCircle.Position = Vector2.new(mousePos.X, mousePos.Y)
end

-- ====================================================================
-- RAGEBOT TARGETING
-- ====================================================================

local function getRagebotTargets()
    local targets = {}
    local maxDist = Ragebot.Target.MaxDistance
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) then
            local distance = getDistanceToPlayer(player)
            if distance <= maxDist then
                local targetPart = getPart(player, Ragebot.Target.HitPart) or getPart(player, "Head")
                local visible = targetPart and isVisible(targetPart)
                
                if not Ragebot.Target.TargetOnlyVisible or visible then
                    table.insert(targets, {
                        Player = player,
                        Distance = distance,
                        Health = getHealth(player),
                        MaxHealth = getMaxHealth(player),
                        Part = targetPart,
                        Visible = visible,
                    })
                end
            end
        end
    end
    
    if Ragebot.Target.Mode == "closest" then
        table.sort(targets, function(a, b) return a.Distance < b.Distance end)
    elseif Ragebot.Target.Mode == "lowest_health" then
        table.sort(targets, function(a, b) return a.Health < b.Health end)
    end
    
    return targets
end

local function getBestRagebotTarget()
    local targets = getRagebotTargets()
    
    if Ragebot.Visuals.ShowFOV then
        local mousePos = UserInputService:GetMouseLocation()
        local filtered = {}
        
        for _, target in ipairs(targets) do
            if target.Part then
                local screenPos = getScreenPosition(target.Part)
                if screenPos then
                    local dist = (screenPos - mousePos).Magnitude
                    if dist <= Ragebot.Visuals.FOVRadius then
                        table.insert(filtered, target)
                    end
                end
            end
        end
        targets = filtered
    end
    
    if #targets == 0 then return nil end
    return targets[1]
end

-- ====================================================================
-- RAGEBOT SHOOTING
-- ====================================================================

local function executeRagebotShot(target)
    if not target then return false end
    
    -- Get fighter
    local fighter = lt
    if not fighter or not fighter.EquippedItem then return false end
    
    local weapon = fighter.EquippedItem
    local objectID = weapon:Get("ObjectID")
    if not objectID then return false end
    
    local targetPart = RagebotData.CurrentTargetPart
    if not targetPart then
        targetPart = getPart(target, Ragebot.Target.HitPart) or getPart(target, "Head")
        if not targetPart then return false end
        RagebotData.CurrentTargetPart = targetPart
    end
    
    -- Prediction
    local predictedPos = targetPart.Position
    if Ragebot.Prediction.Enabled then
        local hrp = getPart(target, "HumanoidRootPart")
        if hrp then
            local velocity = hrp.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
            local distance = (targetPart.Position - Camera.CFrame.Position).Magnitude
            local predTime = (distance / 3000) * Ragebot.Prediction.Multiplier
            predictedPos = targetPart.Position + (velocity * predTime)
        end
    end
    
    -- Get origin
    local localHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not localHRP then return false end
    
    local origin = localHRP.Position
    
    -- Create shot data
    local shotData = {
        [utf8.char(1)] = {
            [utf8.char(0)] = Utility and Utility:EncodeCFrame(CFrame.new(origin, predictedPos)) or CFrame.new(origin, predictedPos),
            [utf8.char(1)] = Utility and Utility:EncodeCFrame(CFrame.new(origin, predictedPos)) or CFrame.new(origin, predictedPos),
            [utf8.char(2)] = targetPart,
            [utf8.char(3)] = Utility and Utility:EncodeCFrame(CFrame.new(0.43, 0.25, 0.42)) or CFrame.new(0.43, 0.25, 0.42),
        }
    }
    
    -- Fire
    local remote = ReplicatedStorage:FindFirstChild("Remotes") and 
                   ReplicatedStorage.Remotes:FindFirstChild("Replication") and
                   ReplicatedStorage.Remotes.Replication:FindFirstChild("Fighter") and
                   ReplicatedStorage.Remotes.Replication.Fighter:FindFirstChild("UseItem")
    
    if remote then
        pcall(function()
            remote:FireServer(objectID, EnumLib and EnumLib:ToEnum("StartShooting") or "StartShooting", shotData, nil)
        end)
        RagebotData.LastShotTime = tick()
        RagebotData.ShotCount = RagebotData.ShotCount + 1
        return true
    end
    
    return false
end

-- ====================================================================
-- RAGEBOT LOOP
-- ====================================================================

local function updateRagebot()
    if not Ragebot.Enabled then return end
    
    local currentTime = tick()
    local shouldSwitch = false
    
    if RagebotData.CurrentTarget then
        if not isAlive(RagebotData.CurrentTarget) then
            shouldSwitch = true
        elseif currentTime - RagebotData.LastSwitchTime > Ragebot.Target.SwitchDelay then
            shouldSwitch = true
        elseif RagebotData.ShotCount >= Ragebot.Shooting.MaxShotsPerTarget then
            shouldSwitch = true
        end
    else
        shouldSwitch = true
    end
    
    if shouldSwitch then
        local best = getBestRagebotTarget()
        if best then
            RagebotData.CurrentTarget = best.Player
            RagebotData.CurrentTargetPart = best.Part
            RagebotData.LastSwitchTime = currentTime
            RagebotData.ShotCount = 0
            
            -- Update indicator
            if Ragebot.Visuals.ShowTargetIndicator and RagebotData.CurrentTarget then
                if targetIndicator then targetIndicator:Destroy() end
                local char = getCharacter(RagebotData.CurrentTarget)
                if char then
                    targetIndicator = Instance.new("Highlight")
                    targetIndicator.FillColor = Ragebot.Visuals.IndicatorColor
                    targetIndicator.OutlineColor = Color3.fromRGB(255, 255, 255)
                    targetIndicator.FillTransparency = 0.3
                    targetIndicator.OutlineTransparency = 0
                    targetIndicator.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    targetIndicator.Adornee = char
                    targetIndicator.Parent = char
                end
            end
        else
            RagebotData.CurrentTarget = nil
            RagebotData.CurrentTargetPart = nil
            if targetIndicator then
                targetIndicator:Destroy()
                targetIndicator = nil
            end
            return
        end
    end
    
    -- Auto shoot
    if Ragebot.Shooting.AutoShoot and RagebotData.CurrentTarget then
        local delay = Ragebot.Shooting.ShootDelay
        if currentTime - RagebotData.LastShotTime >= delay then
            -- Hit chance
            local hitChance = Ragebot.Shooting.HitChance / 100
            if math.random() <= hitChance then
                executeRagebotShot(RagebotData.CurrentTarget)
            end
        end
    end
end

-- ====================================================================
-- MAIN RENDER LOOP
-- ====================================================================

local ragebotUpdateTime = 0

local function onRender()
    trackPlayers()
    updateESP()
    
    if Config.Visuals.FOVCircle then
        updateFOVCircle()
    end
    
    -- Aimbot
    if Config.Aimbot.Enabled then
        local target = getClosestPlayerToCursor()
        if target then
            local targetCF = getTargetCFrame(target)
            if targetCF then
                smoothAim(targetCF)
            end
        end
    end
    
    -- Speed
    if Config.Speed.Enabled then
        setSpeed(Config.Speed.Value)
    end
    
    -- Anti-Aim
    antiAim()
    
    -- Ragebot
    if Ragebot.Enabled then
        ragebotUpdateTime = ragebotUpdateTime + 0.03
        if ragebotUpdateTime >= 0.03 then
            ragebotUpdateTime = 0
            updateRagebot()
        end
        
        -- Update FOV circle for ragebot
        if Ragebot.Visuals.ShowFOV then
            if not RagebotData.FOVCircle then
                RagebotData.FOVCircle = Drawing.new("Circle")
                RagebotData.FOVCircle.Thickness = 1.5
                RagebotData.FOVCircle.NumSides = 36
                RagebotData.FOVCircle.Filled = false
                RagebotData.FOVCircle.Color = Ragebot.Visuals.FOVColor
                RagebotData.FOVCircle.Transparency = 0.3
                RagebotData.FOVCircle.Radius = Ragebot.Visuals.FOVRadius
                RagebotData.FOVCircle.Visible = true
            end
            local mousePos = UserInputService:GetMouseLocation()
            RagebotData.FOVCircle.Position = Vector2.new(mousePos.X, mousePos.Y)
        elseif RagebotData.FOVCircle then
            RagebotData.FOVCircle.Visible = false
        end
    end
end

