local function doSpeed()
    if not Config.Speed.Enabled then return end
    
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = Config.Speed.Value
            if Config.Speed.EnableJump then
                hum.JumpPower = Config.Speed.JumpPower
            end
            if Config.Speed.AutoSprint then
                -- Auto sprint logic would go here
            end
        end
    end
end

-- ====================================================================
-- ANTI-AIM
-- ====================================================================

local function doAntiAim()
    if not Config.AntiAim.Enabled then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Check if should anti-aim
    if Config.AntiAim.OnlyWhenMoving then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.MoveDirection.Magnitude < 0.1 then
            return
        end
    end
    
    -- Calculate yaw
    local yawAngle = 0
    if Config.AntiAim.Mode == "jitter" then
        yawAngle = math.rad(Config.AntiAim.Angle * math.sin(tick() * Config.AntiAim.Speed))
    elseif Config.AntiAim.Mode == "spin" then
        yawAngle = tick() * Config.AntiAim.Speed
    elseif Config.AntiAim.Mode == "static" then
        yawAngle = math.rad(Config.AntiAim.Angle)
    elseif Config.AntiAim.Mode == "random" then
        yawAngle = math.rad(math.random(0, 360))
    elseif Config.AntiAim.Mode == "fake" then
        yawAngle = math.rad(Config.AntiAim.FakeAngle)
    end
    
    if Config.AntiAim.Invert then
        yawAngle = -yawAngle
    end
    
    -- Calculate pitch
    local pitchAngle = 0
    if Config.AntiAim.PitchMode == "up" then
        pitchAngle = math.rad(-Config.AntiAim.Pitch)
    elseif Config.AntiAim.PitchMode == "down" then
        pitchAngle = math.rad(Config.AntiAim.Pitch)
    elseif Config.AntiAim.PitchMode == "random" then
        pitchAngle = math.rad(math.random(-Config.AntiAim.Pitch, Config.AntiAim.Pitch))
    end
    
    hrp.CFrame = hrp.CFrame * CFrame.Angles(pitchAngle, yawAngle, 0)
end

-- ====================================================================
-- RAGEBOT
-- ====================================================================

local function getRagebotTargets()
    local targets = {}
    local mousePos = UserInputService:GetMouseLocation()
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) then
            if isTeammate(player) then continue end
            local dist = getDistance(player)
            if dist <= Config.Ragebot.MaxDistance then
                local targetPart = getPart(player, Config.Ragebot.HitPart) or getPart(player, "Head")
                if targetPart then
                    local visible = isVisible(targetPart)
                    if Config.Ragebot.VisibleCheck and not visible then
                        if not Config.Ragebot.Wallbang or math.random(1, 100) > Config.Ragebot.WallbangChance then
                            continue
                        end
                    end
                    
                    local screenPos = getScreenPos(targetPart)
                    local screenDist = math.huge
                    if screenPos then
                        screenDist = (screenPos - mousePos).Magnitude
                    end
                    
                    -- Check if in FOV
                    if screenDist <= Config.Ragebot.FOV or Config.Ragebot.FOV >= 360 then
                        table.insert(targets, {
                            Player = player,
                            Distance = dist,
                            Health = getHealth(player),
                            MaxHealth = getMaxHealth(player),
                            Part = targetPart,
                            Visible = visible,
                            ScreenDist = screenDist,
                            Priority = 0,
                        })
                    end
                end
            end
        end
    end
    
    -- Calculate priorities
    for _, target in ipairs(targets) do
        local priority = 0
        -- Health priority (lower health = higher priority)
        local healthPercent = target.Health / target.MaxHealth
        priority = priority + (1 - healthPercent) * 50
        -- Distance priority (closer = higher priority)
        priority = priority + (1 - (target.Distance / Config.Ragebot.MaxDistance)) * 30
        -- Visibility priority
        if target.Visible then
            priority = priority + 20
        end
        target.Priority = priority
    end
    
    -- Sort by target mode
    if Config.Ragebot.TargetMode == "closest" then
        table.sort(targets, function(a, b) return a.Distance < b.Distance end)
    elseif Config.Ragebot.TargetMode == "lowest_health" then
        table.sort(targets, function(a, b) return a.Health < b.Health end)
    elseif Config.Ragebot.TargetMode == "highest_threat" then
        table.sort(targets, function(a, b) return a.Priority > b.Priority end)
    elseif Config.Ragebot.TargetMode == "random" then
        table.sort(targets, function(a, b) return math.random() > 0.5 end)
    end
    
    return targets
end

local function getBestRagebotTarget()
    local targets = getRagebotTargets()
    if #targets == 0 then return nil end
    return targets[1]
end

