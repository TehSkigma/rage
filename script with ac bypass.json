 function(idx, object)\n\009\009\009\009return { type = \'Input\', idx = idx, text = object.Value }\n\009\009\009end,\n\009\009\009Load = function(idx, data)\n\009\009\009\009if Options[idx] and type(data.text) == \'string\' then\n\009\009\009\009\009Options[idx]:SetValue(data.text)\n\009\009\009\009end\n\009\009\009end,\n\009\009},\n\n\009\009Theme = {\n\009\009\009Save = function()\n\009\009\009\009local colors = {}\n\009\009\009\009for _, name in ipairs({\"FontColor\", \"MainColor\", \"BackgroundColor\", \"AccentColor\", \"OutlineColor\", \"RiskColor\"}) do\n\009\009\009\009\009if Library[name] then\n\009\009\009\009\009\009colors[name] = Library[name]:ToHex()\n\009\009\009\009\009end\n\009\009\009\009end\n\009\009\009\009return { type = \'Theme\', colors = colors }\n\009\009\009end,\n\009\009\009Load = function(data)\n\009\009\009\009if not data.colors then return end\n\009\009\009\009for name, hex in pairs(data.colors) do\n\009\009\009\009\009if Library[name] then\n\009\009\009\009\009\009Library[name] = Color3.fromHex(hex)\n\009\009\009\009\009end\n\009\009\009\009end\n\009\009\009\009Library:UpdateColorsUsingRegistry()\n\009\009\009end,\n\009\009}\n\009}\n\n\009function SaveManager:SetIgnoreIndexes(list)\n\009\009for _, key in next, list do\n\009\009\009self.Ignore[key] = true\n\009\009end\n\009end\n\n\009function SaveManager:SetFolder(folder)\n\009\009self.Folder = folder\n\009\009pcall(function() self:BuildFolderTree() end)\n\009end\n\n\009function SaveManager:Save(name)\n\009\009if not name or name:gsub(\"%s+\", \"\") == \"\" then\n\009\009\009return false, \"no config name\"\n\009\009end\n\n\009\009local fullPath = self.Folder .. \'/settings/\' .. name .. \'.json\'\n\n\009\009local data = { objects = {}, theme = nil }\n\n\009\009for idx, toggle in next, Toggles do\n\009\009\009if self.Ignore[idx] then continue end\n\009\009\009table.insert(data.objects, self.Parser.Toggle.Save(idx, toggle))\n\009\009end\n\n\009\009for idx, option in next, Options do\n\009\009\009if self.Ignore[idx] then continue end\n\009\009\009\n\009\009\009local parser = nil\n\009\009\009\n\009\009\009if option.Type == \'KeyPicker\' then\n\009\009\009\009parser = self.Parser.KeyPicker\n\009\009\009elseif option.Type == \'Keybind\' then\n\009\009\009\009parser = self.Parser.Keybind\n\009\009\009else\n\009\009\009\009parser = self.Parser[option.Type]\n\009\009\009end\n\009\009\009\n\009\009\009if parser and parser.Save then\n\009\009\009\009table.insert(data.objects, parser.Save(idx, option))\n\009\009\009end\n\009\009end\n\n\009\009data.theme = self.Parser.Theme.Save()\n\n\009\009local success, encoded = pcall(httpService.JSONEncode, httpService, data)\n\009\009if not success then return false, \'encode failed\' end\n\n\009\009writefile(fullPath, encoded)\n\009\009return true\n\009end\n\n\009function SaveManager:Load(name)\n\009\009if not name then return false, \'no config selected\' end\n\n\009\009local file = self.Folder .. \'/settings/\' .. name .. \'.json\'\n\009\009if not isfile(file) then return false, \'file not found\' end\n\n\009\009local success, decoded = pcall(httpService.JSONDecode, httpService, readfile(file))\n\009\009if not success then return false, \'decode failed\' end\n\n\009\009for _, obj in next, decoded.objects or {} do\n\009\009\009local parser = nil\n\009\009\009\n\009\009\009if obj.type == \'KeyPicker\' then\n\009\009\009\009parser = self.Parser.KeyPicker\n\009\009\009elseif obj.type == \'Keybind\' then\n\009\009\009\009parser = self.Parser.Keybind\n\009\009\009else\n\009\009\009\009parser = self.Parser[obj.type]\n\009\009\009end\n\009\009\009\n\009\009\009if parser and parser.Load then\n\009\009\009\009task.spawn(parser.Load, obj.idx, obj)\n\009\009\009end\n\009\009end\n\n\009\009if decoded.theme then\n\009\009\009self.Parser.Theme.Load(decoded.theme)\n\009\009end\n\n\009\009return true\n\009end\n\n\009function SaveManager:IgnoreThemeSettings()\n\009\009self:SetIgnoreIndexes({ \n\009\009\009\"BackgroundColor\", \"MainColor\", \"AccentColor\", \"OutlineColor\", \"FontColor\", \"RiskColor\",\n\009\009\009\"ThemeManager_ThemeList\", \"ThemeManager_CustomThemeList\", \"ThemeManager_CustomThemeName\"\n\009\009})\n\009end\n\n\009function SaveManager:BuildFolderTree()\n\009\009local paths = { self.Folder, self.Folder .. \'/themes\', self.Folder .. \'/settings\' }\n\009\009for _, path in ipairs(paths) do\n\009\009\009if not isfolder(path) then makefolder(path) end\n\009\009end\n\009end\n\n\009function SaveManager:RefreshConfigList()\n\009\009local list = listfiles(self.Folder .. \'/settings\')\n\009\009local out = {}\n\009\009for _, file in ipairs(list) do\n\009\009\009if file:sub(-5) == \'.json\' then\n\009\009\009\009local name = file:match(\"([^/\\\\]+)%.json$\")\n\009\009\009\009if name then table.insert(out, name) end\n\009\009\009end\n\009\009end\n\009\009return out\n\009end\n\n\009function SaveManager:SetLibrary(library)\n\009\009self.Library = library\n\009\009library.SaveManager = self\n\009end\n\n\009function SaveManager:LoadAutoloadConfig()\n\009\009local path = self.Folder .. \'/settings/autoload.txt\'\n\009\009if isfile(path) then\n\009\009\009local name = readfile(path):gsub(\"%s+\", \"\")\n\009\009\009if name ~= \"\" then\n\009\009\009\009local success, err = self:Load(name)\n\009\009\009\009if success then\n\009\009\009\009\009self.Library:Notify(\'Auto-loaded config: \' .. name, 4)\n\009\009\009\009else\n\009\009\009\009\009self.Library:Notify(\'Failed to auto-load: \' .. err, 4)\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\009end\n\n\009function SaveManager:BuildConfigSection(tab)\n\009\009assert(self.Library, \'Library not set\')\n\n\009\009local section = tab:AddRightGroupbox(\'Configs\')\n\n\009\009section:AddInput(\'SaveManager_ConfigName\', { Text = \'Config Name\' })\n\009\009section:AddDropdown(\'SaveManager_ConfigList\', { \n\009\009\009Text = \'Config List\', \n\009\009\009Values = self:RefreshConfigList(), \n\009\009\009AllowNull = true \n\009\009})\n\n\009\009section:AddDivider()\n\n\009\009section:AddButton(\'Create Config\', function()\n\009\009\009local name = Options.SaveManager_ConfigName.Value\n\009\009\009if name:gsub(\"%s+\", \"\") == \"\" then\n\009\009\009\009return self.Library:Notify(\'Config name cannot be empty\', 2)\n\009\009\009end\n\n\009\009\009local success, err = self:Save(name)\n\009\009\009if success then\n\009\009\009\009self.Library:Notify(\'Created config: \' .. name, 3)\n\009\009\009\009Options.SaveManager_ConfigList:SetValues(self:RefreshConfigList())\n\009\009\009else\n\009\009\009\009self.Library:Notify(\'Failed to save: \' .. err, 3)\n\009\009\009end\n\009\009end):AddButton(\'Load Config\', function()\n\009\009\009local name = Options.SaveManager_ConfigList.Value\n\009\009\009if not name then return end\n\n\009\009\009local success, err = self:Load(name)\n\009\009\009if success then\n\009\009\009\009self.Library:Notify(\'Loaded: \' .. name, 3)\n\009\009\009else\n\009\009\009\009self.Library:Notify(\'Load failed: \' .. err, 3)\n\009\009\009end\n\009\009end)\n\n\009\009section:AddButton(\'Overwrite Config\', function()\n\009\009\009local name = Options.SaveManager_ConfigList.Value\n\009\009\009if not name then return end\n\009\009\009local success, err = self:Save(name)\n\009\009\009if success then\n\009\009\009\009self.Library:Notify(\'Overwrote: \' .. name, 3)\n\009\009\009else\n\009\009\009\009self.Library:Notify(\'Overwrite failed: \' .. err, 3)\n\009\009\009end\n\009\009end)\n\n\009\009section:AddButton(\'Refresh List\', function()\n\009\009\009Options.SaveManager_ConfigList:SetValues(self:Refresh
