-- CONFIG SYSTEM
-- ====================================================================

local ConfigSystem = {
    Folder = "RIVALS_Ragebot",
    Configs = {},
    CurrentConfig = "Default",
    AutoLoad = true,
    AutoLoadName = "Default",
}

-- Create folder if it doesn't exist
pcall(function()
    if not isfolder(ConfigSystem.Folder) then
        makefolder(ConfigSystem.Folder)
    end
    if not isfolder(ConfigSystem.Folder .. "/Configs") then
        makefolder(ConfigSystem.Folder .. "/Configs")
    end
end)

-- Get all configs
function ConfigSystem:GetConfigs()
    local configs = {}
    pcall(function()
        local files = listfiles(self.Folder .. "/Configs")
        for _, file in ipairs(files) do
            if file:sub(-5) == ".json" then
                local name = file:match("([^/\\]+)%.json$")
                if name then
                    table.insert(configs, name)
                end
            end
        end
    end)
    return configs
end

-- Save config
function ConfigSystem:Save(name)
    if not name or name == "" then
        name = "Default"
    end
    
    local data = {
        Config = Config,
        Version = "3.0",
        SavedAt = os.time(),
    }
    
    local success, encoded = pcall(function()
        return game:GetService("HttpService"):JSONEncode(data)
    end)
    
    if success and encoded then
        pcall(function()
            writefile(self.Folder .. "/Configs/" .. name .. ".json", encoded)
        end)
        return true
    end
    return false
end

-- Load config
function ConfigSystem:Load(name)
    if not name or name == "" then
        name = "Default"
    end
    
    local file = self.Folder .. "/Configs/" .. name .. ".json"
    if not isfile(file) then
        return false
    end
    
    local success, raw = pcall(function()
        return readfile(file)
    end)
    
    if not success or not raw then
        return false
    end
    
    local success, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(raw)
    end)
    
    if not success or not data or not data.Config then
        return false
    end
    
    -- Merge configs
    local function merge(target, source)
        for key, value in pairs(source) do
            if type(value) == "table" and type(target[key]) == "table" then
                merge(target[key], value)
            else
                target[key] = value
            end
        end
    end
    
    merge(Config, data.Config)
    self.CurrentConfig = name
    
    -- Apply loaded settings
    applyAllSettings()
    
    return true
end

-- Delete config
function ConfigSystem:Delete(name)
    if not name or name == "" then
        return false
    end
    local file = self.Folder .. "/Configs/" .. name .. ".json"
    if isfile(file) then
        pcall(function()
            delfile(file)
        end)
        return true
    end
    return false
end

-- Auto-load
function ConfigSystem:AutoLoad()
    if not self.AutoLoad then return end
    
    -- Check for autoload file
    local autoFile = self.Folder .. "/autoload.txt"
    if isfile(autoFile) then
        local name = readfile(autoFile):gsub("%s+", "")
        if name ~= "" and isfile(self.Folder .. "/Configs/" .. name .. ".json") then
            self:Load(name)
            print("[RIVALS] Auto-loaded config: " .. name)
            return
        end
    end
    
    -- Fallback to default
    if isfile(self.Folder .. "/Configs/Default.json") then
        self:Load("Default")
        print("[RIVALS] Loaded default config")
    end
end

-- Set autoload
function ConfigSystem:SetAutoLoad(name)
    if not name or name == "" then
        name = "Default"
    end
    pcall(function()
        writefile(self.Folder .. "/autoload.txt", name)
    end)
    self.AutoLoadName = name
end

