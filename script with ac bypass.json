local function createCrosshair()
    if crosshair then
        pcall(function() crosshair:Remove() end)
        crosshair = nil
    end
    
    if not Config.Visuals.ShowCrosshair then return end
    
    local lines = {}
    local size = Config.Visuals.CrosshairSize
    local thickness = Config.Visuals.CrosshairThickness
    local color = Config.Visuals.CrosshairColor
    
    -- Top line
    local top = Drawing.new("Line")
    top.From = Vector2.new(-thickness/2, -size)
    top.To = Vector2.new(thickness/2, -size)
    top.Color = color
    top.Thickness = thickness
    top.Visible = true
    table.insert(lines, top)
    
    -- Bottom line
    local bottom = Drawing.new("Line")
    bottom.From = Vector2.new(-thickness/2, size)
    bottom.To = Vector2.new(thickness/2, size)
    bottom.Color = color
    bottom.Thickness = thickness
    bottom.Visible = true
    table.insert(lines, bottom)
    
    -- Left line
    local left = Drawing.new("Line")
    left.From = Vector2.new(-size, -thickness/2)
    left.To = Vector2.new(-size, thickness/2)
    left.Color = color
    left.Thickness = thickness
    left.Visible = true
    table.insert(lines, left)
    
    -- Right line
    local right = Drawing.new("Line")
    right.From = Vector2.new(size, -thickness/2)
    right.To = Vector2.new(size, thickness/2)
    right.Color = color
    right.Thickness = thickness
    right.Visible = true
    table.insert(lines, right)
    
    crosshair = lines
end

local function updateCrosshair()
    if not crosshair then return end
    local mousePos = UserInputService:GetMouseLocation()
    for _, line in ipairs(crosshair) do
        local offset = line.From - line.To
        local center = (line.From + line.To) / 2
        local newCenter = mousePos + (center - center)
        line.From = mousePos + (line.From - center)
        line.To = mousePos + (line.To - center)
    end
end

