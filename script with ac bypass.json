print("[RIVALS] Loading script...")

-- ====================================================================
-- SERVICES
-- ====================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- ====================================================================
-- ANTI-DETECTION
-- ====================================================================

pcall(function()
    local oldMetatable = getrenv and getrenv().setmetatable or setmetatable
    if hookfunction then
        hookfunction(oldMetatable, function(obj, meta)
            if meta and type(meta) == "table" and rawget(meta, "__mode") == "kv" then
                local trace = debug and debug.traceback and debug.traceback() or ""
                if trace:find("MiscellaneousController") or trace:find("AntiCheat") then
                    return oldMetatable({}, {})
                end
            end
            return oldMetatable(obj, meta)
        end)
    end
end)

pcall(function()
    local keywords = {"anticheat", "ac", "detection", "ban", "kick", "security", "moderation"}
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
            local name = pcall(obj.Name.lower, obj) and obj.Name:lower() or ""
            for _, kw in ipairs(keywords) do
                if name:find(kw) then
                    pcall(function() obj.Disabled = true end)
                    break
                end
            end
        end
    end
end)

print("[RIVALS] Anti-detection active")

-- ====================================================================
-- CONFIGURATION
-- ====================================================================

local Config = {
    Aimbot = {
        Enabled = false,
        Smoothing = 0.08,
        FOV = 120,
        HitPart = "Head",
    },
    ESP = {
        Enabled = false,
        Color = Color3.fromRGB(255, 0, 0),
        Transparency = 0.5,
    },
    SilentAim = {
        Enabled = false,
        HitChance = 100,
    },
    Speed = {
        Enabled = false,
        Value = 30,
    },
    AntiAim = {
        Enabled = false,
        Mode = "jitter",
        Angle = 90,
        Speed = 30,
    },
    Ragebot = {
        Enabled = false,
        HitPart = "Head",
        FOV = 180,
        MaxDistance = 500,
        ShootDelay = 0.05,
        HitChance = 95,
        AutoShoot = true,
    },
    Visuals = {
        ShowFOV = true,
        FOVColor = Color3.fromRGB(255, 255, 255),
        FOVRadius = 120,
    }
}

-- ====================================================================
-- DATA
-- ====================================================================

local trackedPlayers = {}
local espHighlights = {}
local fovCircle = nil
local ragebotFOVCircle = nil
local targetIndicator = nil

-- ====================================================================
-- UTILITY FUNCTIONS
-- ====================================================================

local function getCharacter(player)
    if not player then return nil end
    return player.Character
end

local function getHumanoid(player)
    local char = getCharacter(player)
    if char then return char:FindFirstChildOfClass("Humanoid") end
    return nil
end

local function getPart(player, partName)
    local char = getCharacter(player)
    if not char then return nil end
    return char:FindFirstChild(partName) or char:FindFirstChild("HumanoidRootPart")
end

local function isAlive(player)
    local hum = getHumanoid(player)
    return hum and hum.Health > 0
end

local function getHealth(player)
    local hum = getHumanoid(player)
    return hum and hum.Health or 0
end

local function getDistance(player)
    local char1 = LocalPlayer.Character
    local char2 = getCharacter(player)
    if not char1 or not char2 then return math.huge end
    local hrp1 = char1:FindFirstChild("HumanoidRootPart")
    local hrp2 = char2:FindFirstChild("HumanoidRootPart")
    if hrp1 and hrp2 then
        return (hrp1.Position - hrp2.Position).Magnitude
    end
    return math.huge
end

local function isVisible(part)
    if not part or not Camera then return false end
    local origin = Camera.CFrame.Position
    local dir = (part.Position - origin).Unit
    local dist = (part.Position - origin).Magnitude
    local params = RaycastParams.new()
    local char = LocalPlayer.Character
    if char then params.FilterDescendantsInstances = {char} end
    params.FilterType = Enum.RaycastFilterType.Blacklist
    local result = Workspace:Raycast(origin, dir * dist, params)
    return result == nil
end

local function getScreenPos(part)
    if not part or not Camera then return nil end
    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
    if onScreen then return Vector2.new(pos.X, pos.Y) end
    return nil
end

-- ====================================================================
-- PLAYER TRACKING
-- ====================================================================

local function trackPlayers()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = getCharacter(player)
            if char then
                if not trackedPlayers[player] then
                    trackedPlayers[player] = {
                        Name = player.Name,
                        Character = char,
                        RootPart = char:FindFirstChild("HumanoidRootPart"),
                        Head = char:FindFirstChild("Head"),
                        Health = char:FindFirstChildOfClass("Humanoid"),
                        LastPosition = Vector3.new(0, 0, 0),
                        Velocity = Vector3.new(0, 0, 0),
                    }
                end
                local data = trackedPlayers[player]
                if data.Character and data.RootPart then
                    local currentPos = data.RootPart.Position
                    data.Velocity = (currentPos - data.LastPosition) / 0.1
                    data.LastPosition = currentPos
                end
            end
        end
    end
end

-- ====================================================================
-- ESP
-- ====================================================================

local function updateESP()
    if not Config.ESP.Enabled then
        for player, data in pairs(espHighlights) do
            pcall(function() data:Destroy() end)
            espHighlights[player] = nil
        end
        return
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = getCharacter(player)
            if char then
                if not espHighlights[player] then
                    local highlight = Instance.new("Highlight")
                    highlight.FillColor = Config.ESP.Color
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = Config.ESP.Transparency
                    highlight.OutlineTransparency = 0
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Adornee = char
                    highlight.Parent = char
                    espHighlights[player] = highlight
                end
            else
                if espHighlights[player] then
                    pcall(function() espHighlights[player]:Destroy() end)
                    espHighlights[player] = nil
                end
            end
        end
    end
end

-- ====================================================================
-- FOV CIRCLE
-- ====================================================================

local function createFOVCircle()
    if fovCircle then
        pcall(function() fovCircle:Remove() end)
        fovCircle = nil
    end
    
    if not Config.Visuals.ShowFOV then return end
    
    local circle = Drawing.new("Circle")
    circle.Thickness = 1.5
    circle.NumSides = 36
    circle.Filled = false
    circle.Color = Config.Visuals.FOVColor
    circle.Transparency = 0.5
    circle.Radius = Config.Visuals.FOVRadius
    circle.Visible = true
    fovCircle = circle
end

local function updateFOVCircle()
    if not fovCircle then return end
    local mousePos = UserInputService:GetMouseLocation()
    fovCircle.Position = Vector2.new(mousePos.X, mousePos.Y)
end

-- ====================================================================
-- RAGEBOT FOV CIRCLE
-- ====================================================================

local function createRagebotFOVCircle()
    if ragebotFOVCircle then
        pcall(function() ragebotFOVCircle:Remove() end)
        ragebotFOVCircle = nil
    end
    
    if not Config.Ragebot.Enabled then return end
    
    local circle = Drawing.new("Circle")
    circle.Thickness = 1.5
    circle.NumSides = 36
    circle.Filled = false
    circle.Color = Color3.fromRGB(255, 50, 50)
    circle.Transparency = 0.3
    circle.Radius = Config.Ragebot.FOV
    circle.Visible = true
    ragebotFOVCircle = circle
end

local function updateRagebotFOVCircle()
    if not ragebotFOVCircle then return end
    local mousePos = UserInputService:GetMouseLocation()
    ragebotFOVCircle.Position = Vector2.new(mousePos.X, mousePos.Y)
end

-- ====================================================================
-- AIMBOT
-- ====================================================================

local function getClosestPlayerToCursor()
    local mousePos = UserInputService:GetMouseLocation()
    local closest = nil
    local closestDist = Config.Aimbot.FOV
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) then
            local head = getPart(player, Config.Aimbot.HitPart) or getPart(player, "Head")
            if head then
                local screenPos = getScreenPos(head)
                if screenPos then
                    local dist = (screenPos - mousePos).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closest = player
                    end
                end
            end
        end
    end
    
    return closest
end

local function doAimbot()
    if not Config.Aimbot.Enabled then return end
    
    local target = getClosestPlayerToCursor()
    if target then
        local head = getPart(target, Config.Aimbot.HitPart) or getPart(target, "Head")
        if head then
            local targetCF = CFrame.new(Camera.CFrame.Position, head.Position)
            Camera.CFrame = Camera.CFrame:Lerp(targetCF, Config.Aimbot.Smoothing)
            Camera.CameraType = Enum.CameraType.Scriptable
        end
    end
end

-- ====================================================================
-- SPEED
-- ====================================================================

local function doSpeed()
    if not Config.Speed.Enabled then return end
    
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = Config.Speed.Value
        end
    end
end

-- ====================================================================
-- ANTI-AIM
-- ====================================================================

local function doAntiAim()
    if not Config.AntiAim.Enabled then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local angle = 0
    if Config.AntiAim.Mode == "jitter" then
        angle = math.rad(Config.AntiAim.Angle * math.sin(tick() * Config.AntiAim.Speed))
    elseif Config.AntiAim.Mode == "spin" then
        angle = tick() * Config.AntiAim.Speed
    elseif Config.AntiAim.Mode == "static" then
        angle = math.rad(Config.AntiAim.Angle)
    end
    
    hrp.CFrame = hrp.CFrame * CFrame.Angles(0, angle, 0)
end

-- ====================================================================
-- RAGEBOT
-- ====================================================================

local ragebotTarget = nil
local ragebotTargetPart = nil
local ragebotLastShot = 0
local ragebotShotCount = 0

local function getRagebotTarget()
    local mousePos = UserInputService:GetMouseLocation()
    local best = nil
    local bestDist = Config.Ragebot.FOV
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) then
            local dist = getDistance(player)
            if dist <= Config.Ragebot.MaxDistance then
                local targetPart = getPart(player, Config.Ragebot.HitPart) or getPart(player, "Head")
                if targetPart and isVisible(targetPart) then
                    local screenPos = getScreenPos(targetPart)
                    if screenPos then
                        local screenDist = (screenPos - mousePos).Magnitude
                        if screenDist < bestDist then
                            bestDist = screenDist
                            best = player
                            ragebotTargetPart = targetPart
                        end
                    end
                end
            end
        end
    end
    
    return best
end

local function doRagebot()
    if not Config.Ragebot.Enabled then return end
    
    -- Get target
    local target = getRagebotTarget()
    if target then
        ragebotTarget = target
    end
    
    if not ragebotTarget or not isAlive(ragebotTarget) then
        ragebotTarget = nil
        ragebotTargetPart = nil
        return
    end
    
    -- Update target part
    if not ragebotTargetPart then
        ragebotTargetPart = getPart(ragebotTarget, Config.Ragebot.HitPart) or getPart(ragebotTarget, "Head")
    end
    
    if not ragebotTargetPart then return end
    
    -- Update indicator
    if Config.Ragebot.Enabled and ragebotTarget then
        if targetIndicator then
            pcall(function() targetIndicator:Destroy() end)
            targetIndicator = nil
        end
        local char = getCharacter(ragebotTarget)
        if char then
            targetIndicator = Instance.new("Highlight")
            targetIndicator.FillColor = Color3.fromRGB(0, 255, 0)
            targetIndicator.OutlineColor = Color3.fromRGB(255, 255, 255)
            targetIndicator.FillTransparency = 0.3
            targetIndicator.OutlineTransparency = 0
            targetIndicator.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            targetIndicator.Adornee = char
            targetIndicator.Parent = char
        end
    end
    
    -- Auto shoot
    if Config.Ragebot.AutoShoot then
        local now = tick()
        if now - ragebotLastShot >= Config.Ragebot.ShootDelay then
            -- Hit chance
            if math.random() * 100 <= Config.Ragebot.HitChance then
                -- Get weapon (using the game's remote)
                local remote = ReplicatedStorage:FindFirstChild("Remotes")
                if remote then
                    remote = remote:FindFirstChild("Replication")
                    if remote then
                        remote = remote:FindFirstChild("Fighter")
                        if remote then
                            remote = remote:FindFirstChild("UseItem")
                        end
                    end
                end
                
                if remote then
                    local origin = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if origin then
                        local shotData = {
                            [utf8.char(1)] = {
                                [utf8.char(0)] = CFrame.new(origin.Position, ragebotTargetPart.Position),
                                [utf8.char(1)] = CFrame.new(origin.Position, ragebotTargetPart.Position),
                                [utf8.char(2)] = ragebotTargetPart,
                                [utf8.char(3)] = CFrame.new(0.43, 0.25, 0.42),
                            }
                        }
                        pcall(function()
                            remote:FireServer("StartShooting", shotData, nil)
                        end)
                        ragebotLastShot = now
                        ragebotShotCount = ragebotShotCount + 1
                    end
                end
            end
        end
    end
end

-- ====================================================================
-- MAIN RENDER LOOP
-- ====================================================================

local lastRagebotUpdate = 0

local function onRender()
    trackPlayers()
    updateESP()
    
    if Config.Visuals.ShowFOV then
        updateFOVCircle()
    end
    
    doAimbot()
    doSpeed()
    doAntiAim()
    
    -- Update ragebot
    local now = tick()
    if now - lastRagebotUpdate >= 0.05 then
        lastRagebotUpdate = now
        doRagebot()
    end
    
    -- Update ragebot FOV
    if Config.Ragebot.Enabled then
        if not ragebotFOVCircle then
            createRagebotFOVCircle()
        end
        updateRagebotFOVCircle()
    else
        if ragebotFOVCircle then
            pcall(function() ragebotFOVCircle:Remove() end)
            ragebotFOVCircle = nil
        end
        if targetIndicator then
            pcall(function() targetIndicator:Destroy() end)
            targetIndicator = nil
        end
    end
end

-- ====================================================================
-- INPUT HANDLING
-- ====================================================================

local function toggleAimbot()
    Config.Aimbot.Enabled = not Config.Aimbot.Enabled
    print("[RIVALS] Aimbot: " .. tostring(Config.Aimbot.Enabled))
end

local function toggleESP()
    Config.ESP.Enabled = not Config.ESP.Enabled
    print("[RIVALS] ESP: " .. tostring(Config.ESP.Enabled))
end

local function toggleSilentAim()
    Config.SilentAim.Enabled = not Config.SilentAim.Enabled
    print("[RIVALS] Silent Aim: " .. tostring(Config.SilentAim.Enabled))
end

local function toggleSpeed()
    Config.Speed.Enabled = not Config.Speed.Enabled
    print("[RIVALS] Speed: " .. tostring(Config.Speed.Enabled))
end

local function toggleAntiAim()
    Config.AntiAim.Enabled = not Config.AntiAim.Enabled
    print("[RIVALS] Anti-Aim: " .. tostring(Config.AntiAim.Enabled))
end

local function toggleRagebot()
    Config.Ragebot.Enabled = not Config.Ragebot.Enabled
    print("[RIVALS] Ragebot: " .. tostring(Config.Ragebot.Enabled))
    if not Config.Ragebot.Enabled then
        ragebotTarget = nil
        ragebotTargetPart = nil
        if ragebotFOVCircle then
            pcall(function() ragebotFOVCircle:Remove() end)
            ragebotFOVCircle = nil
        end
        if targetIndicator then
            pcall(function() targetIndicator:Destroy() end)
            targetIndicator = nil
        end
    else
        createRagebotFOVCircle()
    end
end

-- Keybinds
local keybinds = {
    [Enum.KeyCode.RightShift] = toggleAimbot,
    [Enum.KeyCode.RightControl] = toggleESP,
    [Enum.KeyCode.PageUp] = toggleSilentAim,
    [Enum.KeyCode.PageDown] = toggleSpeed,
    [Enum.KeyCode.End] = toggleAntiAim,
    [Enum.KeyCode.Insert] = toggleRagebot,
}

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    local func = keybinds[input.KeyCode]
    if func then func() end
end)

